{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-quant-os:contract:paper-market-snapshot:1.0",
  "title": "Paper Market Snapshot v1.0",
  "description": "Simulated paper quote with source freshness metadata; never grants execution authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "instrument_id",
    "bid",
    "ask",
    "observed_at",
    "world_state_version",
    "trusted",
    "freshness",
    "source"
  ],
  "properties": {
    "instrument_id": { "enum": ["EURUSD", "GBPUSD", "USDJPY", "EURJPY"] },
    "bid": { "type": "string", "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0?\\.[0-9]*[1-9][0-9]*)(?:[eE][+-]?[0-9]+)?$" },
    "ask": { "type": "string", "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0?\\.[0-9]*[1-9][0-9]*)(?:[eE][+-]?[0-9]+)?$" },
    "observed_at": { "type": "string", "format": "date-time" },
    "world_state_version": { "type": "string", "minLength": 1 },
    "trusted": { "type": "boolean" },
    "freshness": { "enum": ["FRESH", "STALE"] },
    "source": { "const": "PAPER_SIMULATED" }
  }
}
