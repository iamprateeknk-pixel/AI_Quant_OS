{
  "$defs": {
    "ServiceHealth": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "observation_kind": {
          "const": "DEMO_SYNC_SERVICE",
          "default": "DEMO_SYNC_SERVICE",
          "title": "Observation Kind",
          "type": "string"
        },
        "entry_point": {
          "const": "DEMO_SYNC_SERVICE",
          "default": "DEMO_SYNC_SERVICE",
          "title": "Entry Point",
          "type": "string"
        },
        "run_id": {
          "format": "uuid4",
          "title": "Run Id",
          "type": "string"
        },
        "state": {
          "enum": [
            "RUNNING",
            "STOPPED",
            "HALTED",
            "DISABLED"
          ],
          "title": "State",
          "type": "string"
        },
        "code": {
          "anyOf": [
            {
              "enum": [
                "TICK_LIMIT",
                "SERVICE_FAILURE"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        },
        "ticks": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Ticks",
          "type": "integer"
        },
        "published_at": {
          "format": "date-time",
          "title": "Published At",
          "type": "string"
        },
        "valid_until": {
          "format": "date-time",
          "title": "Valid Until",
          "type": "string"
        },
        "health": {
          "anyOf": [
            {
              "$ref": "#/$defs/SyncHealth"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "may_submit_orders": {
          "const": false,
          "default": false,
          "title": "May Submit Orders",
          "type": "boolean"
        },
        "may_affect_portfolio": {
          "const": false,
          "default": false,
          "title": "May Affect Portfolio",
          "type": "boolean"
        },
        "native_attestation": {
          "const": "UNVERIFIED",
          "default": "UNVERIFIED",
          "title": "Native Attestation",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "state",
        "ticks",
        "published_at",
        "valid_until"
      ],
      "title": "ServiceHealth",
      "type": "object"
    },
    "ServiceHealthView": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "AVAILABLE",
            "STALE",
            "UNAVAILABLE"
