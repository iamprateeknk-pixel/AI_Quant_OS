              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        },
        "revision": {
          "default": 0,
          "maximum": 3000,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
