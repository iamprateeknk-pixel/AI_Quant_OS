        "code": {
          "anyOf": [
            {
              "enum": [
                "STORAGE_UNAVAILABLE",
                "CLOCK_REGRESSION",
                "HISTORY_GAP",
                "CUSTODY_UNCERTAIN",
                "SOURCE_FAILURE",
                "PROJECTION_FAILURE",
