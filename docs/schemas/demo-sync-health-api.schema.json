              "type": "null"
            }
          ],
          "default": null,
          "title": "Last History End"
        },
        "last_success_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Success At"
        },
        "consecutive_failures": {
          "default": 0,
          "maximum": 3000,
          "minimum": 0,
          "title": "Consecutive Failures",
          "type": "integer"
        },
        "pending_attempt_id": {
          "anyOf": [
            {
              "format": "uuid4",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pending Attempt Id"
        },
        "pending_history_start": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pending History Start"
        },
        "pending_history_end": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pending History End"
        },
        "may_submit_orders": {
          "const": false,
          "default": false,
          "title": "May Submit Orders",
          "type": "boolean"
        },
        "may_affect_portfolio": {
          "const": false,
          "default": false,
          "title": "May Affect Portfolio",
          "type": "boolean"
        },
        "native_attestation": {
          "const": "UNVERIFIED",
          "default": "UNVERIFIED",
          "title": "Native Attestation",
          "type": "string"
        }
      },
      "required": [
        "state",
        "observed_at",
        "next_due_at"
      ],
      "title": "SyncHealth",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_kind": {
      "const": "LOCAL_UNVERIFIED_HEARTBEAT",
      "default": "LOCAL_UNVERIFIED_HEARTBEAT",
      "title": "Source Kind",
      "type": "string"
    },
    "configured": {
      "title": "Configured",
      "type": "boolean"
    },
    "observation": {
      "$ref": "#/$defs/ServiceHealthView"
    },
    "may_submit_orders": {
      "const": false,
      "default": false,
      "title": "May Submit Orders",
      "type": "boolean"
    },
    "may_affect_portfolio": {
      "const": false,
      "default": false,
      "title": "May Affect Portfolio",
      "type": "boolean"
    }
  },
  "required": [
    "configured",
    "observation"
  ],
  "title": "DemoSyncHealthResponse",
  "type": "object"
}
