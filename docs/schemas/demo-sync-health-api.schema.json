          "title": "State",
          "type": "string"
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/ServiceHealth"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "may_submit_orders": {
          "const": false,
          "default": false,
          "title": "May Submit Orders",
          "type": "boolean"
        },
        "may_affect_portfolio": {
          "const": false,
          "default": false,
          "title": "May Affect Portfolio",
          "type": "boolean"
        }
      },
      "required": [
        "state"
      ],
      "title": "ServiceHealthView",
      "type": "object"
    },
    "SyncHealth": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "observation_kind": {
          "const": "DEMO_SYNC_HEALTH",
          "default": "DEMO_SYNC_HEALTH",
          "title": "Observation Kind",
          "type": "string"
