{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "intent_id": {
      "title": "Intent Id",
      "type": "string"
    },
    "strategy_id": {
      "title": "Strategy Id",
      "type": "string"
    },
    "strategy_version": {
      "title": "Strategy Version",
      "type": "string"
    },
    "instrument_id": {
      "title": "Instrument Id",
      "type": "string"
    },
    "side": {
      "enum": [
        "BUY",
        "SELL"
      ],
      "title": "Side",
      "type": "string"
    },
    "desired_exposure": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Desired Exposure"
    },
    "risk_budget": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Risk Budget"
    },
    "max_spread": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Max Spread"
    },
    "max_slippage": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Max Slippage"
    },
    "valid_until": {
      "format": "date-time",
      "title": "Valid Until",
      "type": "string"
    },
    "world_state_version": {
      "title": "World State Version",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "intent_id",
    "strategy_id",
    "strategy_version",
    "instrument_id",
    "side",
    "desired_exposure",
    "risk_budget",
    "max_spread",
    "max_slippage",
    "valid_until",
    "world_state_version",
    "evidence_refs",
    "created_at"
  ],
  "title": "IntentInput",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-quant-os:contract:trade-intent:1.0"
}
