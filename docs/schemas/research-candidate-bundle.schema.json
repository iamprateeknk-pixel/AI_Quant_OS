        "dataset_fingerprint": {
          "title": "Dataset Fingerprint",
          "type": "string"
        },
        "genome_sha256": {
          "title": "Genome Sha256",
          "type": "string"
        },
        "implementation_sha256": {
          "title": "Implementation Sha256",
          "type": "string"
        },
        "pnl_currency": {
          "title": "Pnl Currency",
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/MonteCarloResult"
