        }
      },
      "required": [
        "schema_version",
        "engine",
        "engine_version",
        "replay_model",
        "venue",
        "instrument_id",
        "pnl_currency",
        "strategy_ref",
        "dataset_fingerprint",
        "costs",
        "fills",
        "native_order_count",
        "final_position",
        "net_pnl",
        "pnl_method",
        "native_realized_pnl"
