{
  "$defs": {
    "AdversarialScenario": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "dataset_fingerprint": {
          "title": "Dataset Fingerprint",
          "type": "string"
        },
        "run": {
          "$ref": "#/$defs/RegisteredBacktest"
        }
      },
      "required": [
        "name",
        "dataset_fingerprint",
        "run"
      ],
      "title": "AdversarialScenario",
      "type": "object"
    },
    "AdversarialSpec": {
      "properties": {
        "drop_every": {
          "default": 5,
          "title": "Drop Every",
          "type": "integer"
        },
        "shock_bps": {
          "default": 1000,
          "title": "Shock Bps",
          "type": "integer"
        },
        "maximum_loss": {
          "default": "100",
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Maximum Loss",
          "type": "string"
        },
        "risk_currency": {
          "default": "USD",
          "title": "Risk Currency",
          "type": "string"
        },
        "method": {
          "default": "MISSING_AND_DOWNWARD_STEP_V1",
          "title": "Method",
          "type": "string"
        }
      },
      "title": "AdversarialSpec",
      "type": "object"
    },
    "BacktestCosts": {
      "properties": {
        "slippage_bps": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Slippage Bps",
          "type": "string"
        },
        "fee_per_trade": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Fee Per Trade",
          "type": "string"
        }
      },
      "required": [
        "slippage_bps",
        "fee_per_trade"
      ],
      "title": "BacktestCosts",
      "type": "object"
    },
    "Bar": {
      "properties": {
        "instrument_id": {
          "title": "Instrument Id",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "open": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Open",
          "type": "string"
        },
        "high": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "High",
          "type": "string"
        },
        "low": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Low",
          "type": "string"
        },
        "close": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Close",
          "type": "string"
        },
        "volume": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Volume",
          "type": "string"
        }
      },
      "required": [
        "instrument_id",
        "observed_at",
        "open",
        "high",
        "low",
        "close",
        "volume"
      ],
      "title": "Bar",
      "type": "object"
    },
    "CandidateManifest": {
      "properties": {
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "experiment_id": {
          "title": "Experiment Id",
          "type": "string"
        },
        "hypothesis_id": {
          "title": "Hypothesis Id",
          "type": "string"
        },
        "report_sha256": {
          "title": "Report Sha256",
          "type": "string"
        },
        "plan_sha256": {
          "title": "Plan Sha256",
          "type": "string"
        },
        "selected_genome": {
          "anyOf": [
            {
              "$ref": "#/$defs/StrategyGenome"
            },
            {
              "type": "null"
            }
          ]
        },
        "research_outcome": {
          "enum": [
            "FAILED",
            "REJECTED",
            "VALIDATION_INCOMPLETE"
          ],
          "title": "Research Outcome",
          "type": "string"
        },
        "blocking_gates": {
          "items": {
            "type": "string"
          },
          "title": "Blocking Gates",
          "type": "array"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "promotion_allowed": {
          "const": false,
          "title": "Promotion Allowed",
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "candidate_id",
        "experiment_id",
        "hypothesis_id",
        "report_sha256",
        "plan_sha256",
        "selected_genome",
        "research_outcome",
        "blocking_gates",
        "reasons",
        "promotion_allowed"
      ],
      "title": "CandidateManifest",
      "type": "object"
    },
    "CandidateSource": {
      "properties": {
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "sha256",
        "text"
      ],
      "title": "CandidateSource",
      "type": "object"
    },
    "FoldEvidence": {
      "properties": {
        "index": {
          "title": "Index",
          "type": "integer"
        },
        "training_results": {
          "items": {
            "$ref": "#/$defs/RegisteredBacktest"
          },
          "title": "Training Results",
          "type": "array"
        },
        "validation": {
          "$ref": "#/$defs/RegisteredBacktest"
        },
        "stress": {
          "$ref": "#/$defs/RegisteredBacktest"
        }
      },
      "required": [
        "index",
        "training_results",
        "validation",
        "stress"
      ],
      "title": "FoldEvidence",
      "type": "object"
    },
    "Hypothesis": {
      "properties": {
        "hypothesis_id": {
          "title": "Hypothesis Id",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "hypothesis_id",
        "description"
      ],
      "title": "Hypothesis",
      "type": "object"
    },
    "MonteCarloResult": {
      "properties": {
        "spec": {
          "$ref": "#/$defs/MonteCarloSpec"
        },
        "sample_fingerprint": {
          "title": "Sample Fingerprint",
          "type": "string"
        },
        "closed_trade_count": {
          "title": "Closed Trade Count",
          "type": "integer"
        },
        "open_position": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Open Position",
          "type": "string"
        },
        "state": {
          "enum": [
            "PASS",
            "FAIL",
            "PENDING"
          ],
          "title": "State",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "lower_tail_pnl": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Lower Tail Pnl"
        },
        "median_pnl": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Median Pnl"
        },
        "drawdown_p95": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Drawdown P95"
        },
        "positive_fraction": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Positive Fraction"
        },
        "simulation_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Simulation Sha256"
        },
        "drawdown_basis": {
          "const": "TRADE_CLOSE_CASHFLOW",
          "default": "TRADE_CLOSE_CASHFLOW",
          "title": "Drawdown Basis",
          "type": "string"
        }
      },
      "required": [
        "spec",
        "sample_fingerprint",
        "closed_trade_count",
        "open_position",
        "state",
        "reason",
        "lower_tail_pnl",
        "median_pnl",
        "drawdown_p95",
        "positive_fraction",
        "simulation_sha256"
      ],
      "title": "MonteCarloResult",
      "type": "object"
    },
    "MonteCarloSpec": {
      "properties": {
        "seed": {
          "default": 17,
          "title": "Seed",
          "type": "integer"
        },
        "iterations": {
          "default": 500,
          "title": "Iterations",
          "type": "integer"
        },
        "block_size": {
          "default": 4,
          "title": "Block Size",
          "type": "integer"
        },
        "min_closed_trades": {
          "default": 20,
          "title": "Min Closed Trades",
          "type": "integer"
        },
        "lower_tail_percent": {
          "default": 5,
          "title": "Lower Tail Percent",
          "type": "integer"
        },
        "minimum_positive_fraction": {
          "default": "0.95",
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Minimum Positive Fraction",
          "type": "string"
        },
        "drawdown_limit": {
          "default": "100",
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Drawdown Limit",
          "type": "string"
        },
        "risk_currency": {
          "default": "USD",
          "enum": [
            "USD",
            "JPY"
          ],
          "title": "Risk Currency",
          "type": "string"
        },
        "method": {
          "const": "CIRCULAR_CLOSED_TRADE_BLOCKS_SHA256_V1",
          "default": "CIRCULAR_CLOSED_TRADE_BLOCKS_SHA256_V1",
          "title": "Method",
          "type": "string"
        }
      },
      "title": "MonteCarloSpec",
      "type": "object"
    },
    "NativeAdversarial": {
      "properties": {
        "source_bars": {
