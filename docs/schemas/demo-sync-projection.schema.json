        "history_start": {
          "format": "date-time",
          "title": "History Start",
          "type": "string"
        },
        "history_through": {
          "format": "date-time",
          "title": "History Through",
          "type": "string"
        },
        "missing_prior_deals": {
          "items": {
            "type": "string"
          },
          "title": "Missing Prior Deals",
          "type": "array"
        },
        "quote_context": {
          "enum": [
            "FRESH",
            "STALE"
          ],
          "title": "Quote Context",
          "type": "string"
        },
        "batch": {
          "$ref": "#/$defs/SyncBatch"
        },
        "history_attestation": {
          "const": "UNVERIFIED",
          "default": "UNVERIFIED",
          "title": "History Attestation",
          "type": "string"
        },
        "may_submit_orders": {
          "const": false,
          "default": false,
          "title": "May Submit Orders",
          "type": "boolean"
        },
        "may_affect_portfolio": {
          "const": false,
          "default": false,
          "title": "May Affect Portfolio",
          "type": "boolean"
        }
      },
      "required": [
        "latest_attempt_id",
        "latest_receipt_ref",
        "receipts",
        "known_deals",
        "revision_count",
        "history_start",
        "history_through",
        "missing_prior_deals",
        "quote_context",
        "batch"
      ],
      "title": "ProjectionView",
