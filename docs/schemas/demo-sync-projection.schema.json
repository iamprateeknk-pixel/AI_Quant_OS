{
  "$defs": {
    "AccountView": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "balance": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Balance"
        },
        "credit": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Credit"
        },
        "equity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Equity"
        },
        "profit": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Profit"
        },
        "margin": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Margin"
        },
        "margin_free": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Margin Free"
        },
        "margin_mode": {
          "enum": [
            "NETTING",
            "EXCHANGE",
            "HEDGING"
          ],
          "title": "Margin Mode",
          "type": "string"
        },
        "leverage": {
          "exclusiveMinimum": 0,
          "title": "Leverage",
          "type": "integer"
        }
      },
      "required": [
        "currency",
        "balance",
        "credit",
        "equity",
        "profit",
        "margin",
        "margin_free",
        "margin_mode",
        "leverage"
      ],
      "title": "AccountView",
      "type": "object"
    },
    "CashEvent": {
      "additionalProperties": false,
      "properties": {
        "ticket": {
          "exclusiveMinimum": 0,
          "title": "Ticket",
          "type": "integer"
        },
        "event_ref": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Event Ref",
          "type": "string"
        },
        "order_ticket": {
          "minimum": 0,
          "title": "Order Ticket",
          "type": "integer"
        },
        "position_identifier": {
          "minimum": 0,
          "title": "Position Identifier",
          "type": "integer"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "currency": {
          "title": "Currency",
          "type": "string"
        },
        "profit": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Profit"
        },
        "commission": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Commission"
        },
        "swap": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Swap"
        },
        "fee": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Fee"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "ticket",
        "event_ref",
        "order_ticket",
        "position_identifier",
        "observed_at",
        "currency",
        "profit",
        "commission",
        "swap",
        "fee",
        "kind"
      ],
      "title": "CashEvent",
      "type": "object"
    },
    "DealVersion": {
      "additionalProperties": false,
      "properties": {
        "event_ref": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Event Ref",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "FILL",
            "CASH"
          ],
          "title": "Kind",
          "type": "string"
        },
        "content_ref": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Ref",
          "type": "string"
        },
        "source_attempt_id": {
          "format": "uuid4",
          "title": "Source Attempt Id",
          "type": "string"
        },
        "source_receipt_ref": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Receipt Ref",
          "type": "string"
        },
        "observed_in_capture": {
          "format": "date-time",
          "title": "Observed In Capture",
          "type": "string"
        },
        "payload": {
          "anyOf": [
            {
              "$ref": "#/$defs/FillView"
            },
            {
              "$ref": "#/$defs/CashEvent"
            }
          ],
          "title": "Payload"
        },
        "native_correction_attestation": {
          "const": "UNVERIFIED",
          "default": "UNVERIFIED",
          "title": "Native Correction Attestation",
          "type": "string"
        }
      },
      "required": [
        "event_ref",
        "revision",
        "kind",
        "content_ref",
        "source_attempt_id",
        "source_receipt_ref",
        "observed_in_capture",
        "payload"
      ],
      "title": "DealVersion",
      "type": "object"
    },
    "DemoQuote": {
