    "ProjectionResult": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "state": {
          "enum": [
            "DISABLED",
            "APPLIED",
            "ALREADY_APPLIED",
            "WITHHELD"
          ],
          "title": "State",
          "type": "string"
        },
        "code": {
          "anyOf": [
            {
              "enum": [
                "SOURCE_WITHHELD",
                "STORAGE_UNAVAILABLE",
                "ATTEMPT_CONFLICT",
                "FOREIGN_SCOPE",
                "STALE_OBSERVATION",
                "HISTORY_GAP",
                "CAPACITY"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        },
        "attempt_id": {
          "format": "uuid4",
          "title": "Attempt Id",
          "type": "string"
        },
        "new_deals": {
          "default": 0,
          "minimum": 0,
          "title": "New Deals",
          "type": "integer"
        },
        "revised_deals": {
          "default": 0,
          "minimum": 0,
          "title": "Revised Deals",
          "type": "integer"
        },
        "may_submit_orders": {
          "const": false,
          "default": false,
          "title": "May Submit Orders",
          "type": "boolean"
        },
        "may_affect_portfolio": {
          "const": false,
          "default": false,
          "title": "May Affect Portfolio",
          "type": "boolean"
        }
      },
      "required": [
        "state",
        "attempt_id"
      ],
      "title": "ProjectionResult",
      "type": "object"
    },
    "ProjectionView": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "observation_kind": {
          "const": "ACCOUNT_SYNC_PROJECTION",
          "default": "ACCOUNT_SYNC_PROJECTION",
          "title": "Observation Kind",
          "type": "string"
        },
        "latest_attempt_id": {
