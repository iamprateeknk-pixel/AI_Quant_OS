{
  "$defs": {
    "JournalCommitment": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "gateway.sqlite",
            "projection.sqlite",
            "controller.sqlite"
          ],
          "title": "Name",
          "type": "string"
        },
        "bytes": {
          "exclusiveMinimum": 0,
          "maximum": 100663296,
          "title": "Bytes",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "name",
        "bytes",
        "sha256"
      ],
      "title": "JournalCommitment",
      "type": "object"
    },
    "PendingReceiptInspection": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "NOT_PENDING",
            "FINISHED",
            "UNAVAILABLE"
          ],
          "title": "State",
          "type": "string"
        },
        "receipt_ref": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Receipt Ref"
        },
        "report_state": {
          "anyOf": [
            {
              "enum": [
                "CAPTURED",
                "WITHHELD"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Report State"
        },
        "report_code": {
          "anyOf": [
            {
              "pattern": "^[A-Z][A-Z_]{0,31}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Report Code"
        },
        "gateway_code": {
          "anyOf": [
            {
              "pattern": "^[A-Z][A-Z_]{0,31}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gateway Code"
        }
      },
      "required": [
        "state"
      ],
      "title": "PendingReceiptInspection",
      "type": "object"
    },
    "ProjectionInspection": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "MATCHED",
            "EMPTY",
            "MISMATCH",
            "UNAVAILABLE",
            "UNVERIFIED_CURSOR"
          ],
          "title": "State",
          "type": "string"
        },
        "receipts": {
          "default": 0,
          "maximum": 1000,
          "minimum": 0,
          "title": "Receipts",
          "type": "integer"
        },
        "known_deals": {
          "default": 0,
          "maximum": 4096,
          "minimum": 0,
          "title": "Known Deals",
          "type": "integer"
        },
        "history_start": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "History Start"
        },
        "history_through": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "History Through"
        },
        "quote_context": {
          "anyOf": [
            {
              "enum": [
                "FRESH",
                "STALE"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote Context"
        }
      },
      "required": [
        "state"
      ],
      "title": "ProjectionInspection",
      "type": "object"
    },
    "SyncHealth": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "observation_kind": {
          "const": "DEMO_SYNC_HEALTH",
          "default": "DEMO_SYNC_HEALTH",
          "title": "Observation Kind",
          "type": "string"
        },
        "state": {
          "enum": [
            "DISABLED",
            "STARTING",
            "ACTIVE",
            "HEALTHY",
            "DEGRADED",
            "HALTED"
          ],
          "title": "State",
          "type": "string"
        },
        "code": {
          "anyOf": [
            {
              "enum": [
                "STORAGE_UNAVAILABLE",
                "CLOCK_REGRESSION",
                "HISTORY_GAP",
                "CUSTODY_UNCERTAIN",
                "SOURCE_FAILURE",
                "PROJECTION_FAILURE",
                "CAPACITY"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        },
        "revision": {
          "default": 0,
          "maximum": 3000,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "next_due_at": {
          "format": "date-time",
          "title": "Next Due At",
          "type": "string"
        },
        "last_history_end": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last History End"
        },
        "last_success_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Success At"
        },
        "consecutive_failures": {
          "default": 0,
          "maximum": 3000,
          "minimum": 0,
          "title": "Consecutive Failures",
          "type": "integer"
        },
        "pending_attempt_id": {
          "anyOf": [
            {
              "format": "uuid4",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pending Attempt Id"
        },
        "pending_history_start": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pending History Start"
        },
        "pending_history_end": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pending History End"
        },
        "may_submit_orders": {
          "const": false,
          "default": false,
          "title": "May Submit Orders",
          "type": "boolean"
        },
        "may_affect_portfolio": {
          "const": false,
          "default": false,
          "title": "May Affect Portfolio",
          "type": "boolean"
        },
        "native_attestation": {
          "const": "UNVERIFIED",
          "default": "UNVERIFIED",
          "title": "Native Attestation",
          "type": "string"
        }
      },
      "required": [
        "state",
        "observed_at",
        "next_due_at"
      ],
      "title": "SyncHealth",
      "type": "object"
    },
    "SyncInspection": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "observation_kind": {
          "const": "LOCAL_UNVERIFIED_JOURNAL_INSPECTION",
          "default": "LOCAL_UNVERIFIED_JOURNAL_INSPECTION",
          "title": "Observation Kind",
          "type": "string"
        },
        "state": {
          "enum": [
            "READABLE",
            "PARTIAL",
            "UNAVAILABLE"
          ],
          "title": "State",
          "type": "string"
        },
        "inspected_at": {
          "format": "date-time",
          "title": "Inspected At",
          "type": "string"
        },
        "controller_state": {
          "enum": [
            "AVAILABLE",
            "UNAVAILABLE"
          ],
          "title": "Controller State",
          "type": "string"
        },
        "health": {
          "anyOf": [
            {
              "$ref": "#/$defs/SyncHealth"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "gateway_custody": {
          "enum": [
            "ALL_FINISHED",
            "CUSTODY_UNCERTAIN",
            "STORAGE_UNAVAILABLE"
          ],
          "title": "Gateway Custody",
          "type": "string"
        },
        "projection": {
          "$ref": "#/$defs/ProjectionInspection"
        },
        "pending_receipt": {
          "$ref": "#/$defs/PendingReceiptInspection"
        },
        "clock_condition": {
          "enum": [
            "AT_OR_AFTER_STATE",
            "BEFORE_STATE",
            "UNAVAILABLE"
          ],
          "title": "Clock Condition",
          "type": "string"
        },
        "configured_capture_enabled": {
          "title": "Configured Capture Enabled",
          "type": "boolean"
        },
        "may_capture": {
          "const": false,
          "default": false,
          "title": "May Capture",
          "type": "boolean"
        },
        "may_submit_orders": {
          "const": false,
          "default": false,
          "title": "May Submit Orders",
          "type": "boolean"
        },
        "may_affect_portfolio": {
          "const": false,
          "default": false,
          "title": "May Affect Portfolio",
          "type": "boolean"
        },
        "native_attestation": {
          "const": "UNVERIFIED",
          "default": "UNVERIFIED",
          "title": "Native Attestation",
          "type": "string"
        }
      },
      "required": [
        "state",
        "inspected_at",
        "controller_state",
        "gateway_custody",
        "projection",
        "pending_receipt",
        "clock_condition",
        "configured_capture_enabled"
      ],
      "title": "SyncInspection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "artifact_kind": {
      "const": "LOCAL_UNVERIFIED_SYNC_CHECKPOINT",
      "default": "LOCAL_UNVERIFIED_SYNC_CHECKPOINT",
      "title": "Artifact Kind",
      "type": "string"
    },
    "policy_ref": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Policy Ref",
      "type": "string"
    },
    "journals": {
      "items": {
        "$ref": "#/$defs/JournalCommitment"
      },
      "maxItems": 3,
      "minItems": 3,
      "title": "Journals",
      "type": "array"
    },
    "inspection": {
      "$ref": "#/$defs/SyncInspection"
    },
    "may_capture": {
      "const": false,
      "default": false,
      "title": "May Capture",
      "type": "boolean"
    },
    "may_submit_orders": {
      "const": false,
      "default": false,
      "title": "May Submit Orders",
      "type": "boolean"
    },
    "may_affect_portfolio": {
      "const": false,
      "default": false,
      "title": "May Affect Portfolio",
      "type": "boolean"
    },
    "native_attestation": {
      "const": "UNVERIFIED",
      "default": "UNVERIFIED",
      "title": "Native Attestation",
      "type": "string"
    }
  },
  "required": [
    "policy_ref",
    "journals",
    "inspection"
  ],
  "title": "SyncCheckpoint",
  "type": "object"
}
