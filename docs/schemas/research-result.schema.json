{
  "type": "object",
  "required": [
    "schema_version",
    "report",
    "report_sha256",
    "source_lineage"
  ],
  "additionalProperties": false,
  "$defs": {
    "BacktestCosts": {
      "properties": {
        "slippage_bps": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Slippage Bps",
          "type": "string"
        },
        "fee_per_trade": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Fee Per Trade",
          "type": "string"
        }
      },
      "required": [
        "slippage_bps",
        "fee_per_trade"
      ],
      "title": "BacktestCosts",
      "type": "object"
    },
    "FoldEvidence": {
      "properties": {
        "index": {
          "title": "Index",
          "type": "integer"
        },
        "training_results": {
          "items": {
            "$ref": "#/$defs/RegisteredBacktest"
          },
          "title": "Training Results",
          "type": "array"
        },
        "validation": {
          "$ref": "#/$defs/RegisteredBacktest"
        },
        "stress": {
          "$ref": "#/$defs/RegisteredBacktest"
        }
      },
      "required": [
        "index",
        "training_results",
        "validation",
        "stress"
      ],
      "title": "FoldEvidence",
      "type": "object"
    },
    "Hypothesis": {
      "properties": {
        "hypothesis_id": {
          "title": "Hypothesis Id",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "hypothesis_id",
        "description"
      ],
      "title": "Hypothesis",
      "type": "object"
    },
    "NativeFill": {
      "properties": {
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "side": {
          "enum": [
            "BUY",
            "SELL"
          ],
          "title": "Side",
          "type": "string"
        },
        "price": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Price",
          "type": "string"
        },
        "quantity": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Quantity",
          "type": "string"
        },
        "fee": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Fee",
          "type": "string"
        }
      },
      "required": [
        "observed_at",
        "side",
        "price",
        "quantity",
        "fee"
      ],
      "title": "NativeFill",
      "type": "object"
    },
    "NautilusResult": {
      "properties": {
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "engine": {
          "const": "NAUTILUS_BACKTEST",
          "title": "Engine",
          "type": "string"
        },
        "engine_version": {
          "const": "1.221.0",
          "title": "Engine Version",
          "type": "string"
        },
        "replay_model": {
          "enum": [
            "BAR_OPEN_CLOSE_QUOTES_V1",
            "RECORDED_QUOTE_TICKS_V1"
          ],
          "title": "Replay Model",
          "type": "string"
        },
        "venue": {
          "const": "PAPER",
          "title": "Venue",
          "type": "string"
        },
        "instrument_id": {
          "title": "Instrument Id",
          "type": "string"
        },
        "pnl_currency": {
          "title": "Pnl Currency",
          "type": "string"
        },
        "strategy_ref": {
          "title": "Strategy Ref",
          "type": "string"
        },
        "dataset_fingerprint": {
          "title": "Dataset Fingerprint",
          "type": "string"
        },
        "costs": {
          "$ref": "#/$defs/BacktestCosts"
        },
        "fills": {
          "items": {
            "$ref": "#/$defs/NativeFill"
          },
          "title": "Fills",
          "type": "array"
        },
        "native_order_count": {
          "title": "Native Order Count",
          "type": "integer"
        },
        "final_position": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Final Position",
          "type": "string"
        },
        "net_pnl": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Net Pnl",
          "type": "string"
        },
        "pnl_method": {
          "enum": [
            "EXACT_FILL_CASHFLOWS_PLUS_FINAL_CLOSE_MARK",
            "EXACT_FILL_CASHFLOWS_PLUS_FINAL_QUOTE_MIDPOINT"
          ],
          "title": "Pnl Method",
          "type": "string"
        },
        "native_realized_pnl": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Native Realized Pnl",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "engine",
        "engine_version",
        "replay_model",
        "venue",
        "instrument_id",
        "pnl_currency",
        "strategy_ref",
        "dataset_fingerprint",
        "costs",
        "fills",
        "native_order_count",
        "final_position",
        "net_pnl",
        "pnl_method",
        "native_realized_pnl"
      ],
      "title": "NautilusResult",
      "type": "object"
    },
    "RegisteredBacktest": {
      "properties": {
        "result": {
          "$ref": "#/$defs/NautilusResult"
        },
        "binding": {
          "$ref": "#/$defs/StrategyBinding"
        }
      },
      "required": [
        "result",
        "binding"
      ],
      "title": "RegisteredBacktest",
      "type": "object"
    },
    "ResearchDatasetScope": {
      "properties": {
        "instrument_id": {
          "title": "Instrument Id",
          "type": "string"
        },
        "first_observed_at": {
          "format": "date-time",
          "title": "First Observed At",
          "type": "string"
        },
        "last_observed_at": {
          "format": "date-time",
          "title": "Last Observed At",
          "type": "string"
        },
        "dataset_fingerprint": {
          "title": "Dataset Fingerprint",
          "type": "string"
        }
      },
      "required": [
        "instrument_id",
        "first_observed_at",
        "last_observed_at",
        "dataset_fingerprint"
      ],
      "title": "ResearchDatasetScope",
      "type": "object"
    },
    "ResearchGate": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "state": {
          "enum": [
            "PASS",
            "FAIL",
            "PENDING"
          ],
          "title": "State",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "name",
        "state",
        "reason"
      ],
      "title": "ResearchGate",
      "type": "object"
    },
    "ResearchPlan": {
      "properties": {
        "experiment_id": {
          "title": "Experiment Id",
          "type": "string"
        },
        "hypothesis": {
          "$ref": "#/$defs/Hypothesis"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/StrategyGenome"
          },
          "title": "Candidates",
          "type": "array"
        },
        "development_fingerprint": {
          "title": "Development Fingerprint",
          "type": "string"
        },
        "development_scope": {
          "$ref": "#/$defs/ResearchDatasetScope"
        },
        "holdout_fingerprint": {
          "title": "Holdout Fingerprint",
          "type": "string"
        },
        "holdout_scope": {
          "$ref": "#/$defs/ResearchDatasetScope"
        },
        "train_bars": {
          "title": "Train Bars",
          "type": "integer"
        },
        "validation_bars": {
          "title": "Validation Bars",
          "type": "integer"
        },
        "quantity": {
          "title": "Quantity",
          "type": "integer"
        },
        "costs": {
          "$ref": "#/$defs/BacktestCosts"
        },
        "stress_costs": {
          "$ref": "#/$defs/BacktestCosts"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "selection_objective": {
          "default": "NET_PNL_THEN_GENOME_SHA256",
          "title": "Selection Objective",
          "type": "string"
        },
        "partition_model": {
          "default": "EXPANDING_COLD_START_V1",
          "title": "Partition Model",
          "type": "string"
        }
      },
      "required": [
        "experiment_id",
        "hypothesis",
        "candidates",
        "development_fingerprint",
        "development_scope",
        "holdout_fingerprint",
        "holdout_scope",
        "train_bars",
        "validation_bars",
        "quantity",
        "costs",
        "stress_costs"
      ],
      "title": "ResearchPlan",
      "type": "object"
    },
    "ResearchSelection": {
      "properties": {
        "genome": {
          "$ref": "#/$defs/StrategyGenome"
        },
        "development_fingerprint": {
          "title": "Development Fingerprint",
          "type": "string"
        },
        "training_results": {
          "items": {
            "$ref": "#/$defs/RegisteredBacktest"
          },
          "title": "Training Results",
          "type": "array"
        }
      },
      "required": [
        "genome",
        "development_fingerprint",
        "training_results"
      ],
      "title": "ResearchSelection",
      "type": "object"
    },
    "SourceFingerprint": {
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "SourceFingerprint",
      "type": "object"
    },
    "StrategyBinding": {
      "properties": {
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "provenance": {
          "const": "TRUSTED_BUILTIN_SOURCE_BINDING",
          "title": "Provenance",
          "type": "string"
        },
        "genome": {
          "$ref": "#/$defs/StrategyGenome"
        },
        "genome_sha256": {
          "title": "Genome Sha256",
          "type": "string"
        },
        "implementation": {
          "$ref": "#/$defs/StrategyImplementation"
        },
        "implementation_sha256": {
          "title": "Implementation Sha256",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "provenance",
        "genome",
        "genome_sha256",
        "implementation",
        "implementation_sha256"
      ],
      "title": "StrategyBinding",
      "type": "object"
    },
    "StrategyGenome": {
      "properties": {
        "strategy_ref": {
          "title": "Strategy Ref",
          "type": "string"
        },
        "input_kind": {
          "enum": [
            "BAR",
            "TICK"
          ],
          "title": "Input Kind",
          "type": "string"
        },
        "parameters": {
          "default": [],
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ],
            "type": "array"
          },
          "title": "Parameters",
          "type": "array"
        }
      },
      "required": [
        "strategy_ref",
        "input_kind"
      ],
      "title": "StrategyGenome",
      "type": "object"
    },
    "StrategyImplementation": {
      "properties": {
        "strategy_ref": {
          "title": "Strategy Ref",
          "type": "string"
        },
        "input_kind": {
          "enum": [
            "BAR",
            "TICK"
          ],
          "title": "Input Kind",
          "type": "string"
        },
        "entry_point": {
          "title": "Entry Point",
          "type": "string"
        },
        "parameter_defaults": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ],
            "type": "array"
          },
          "title": "Parameter Defaults",
          "type": "array"
        },
        "source_files": {
          "items": {
            "$ref": "#/$defs/SourceFingerprint"
          },
          "title": "Source Files",
          "type": "array"
        }
      },
      "required": [
        "strategy_ref",
        "input_kind",
        "entry_point",
        "parameter_defaults",
        "source_files"
      ],
      "title": "StrategyImplementation",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "report": {
      "properties": {
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "plan": {
          "$ref": "#/$defs/ResearchPlan"
        },
        "outcome": {
          "enum": [
            "FAILED",
            "REJECTED",
            "VALIDATION_INCOMPLETE"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "promotion_allowed": {
          "const": false,
          "title": "Promotion Allowed",
          "type": "boolean"
        },
        "selection": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResearchSelection"
            },
            {
              "type": "null"
            }
          ]
        },
        "folds": {
          "items": {
            "$ref": "#/$defs/FoldEvidence"
          },
          "title": "Folds",
          "type": "array"
        },
        "holdout": {
          "anyOf": [
            {
              "$ref": "#/$defs/RegisteredBacktest"
            },
            {
              "type": "null"
            }
          ]
        },
        "holdout_stress": {
          "anyOf": [
            {
              "$ref": "#/$defs/RegisteredBacktest"
            },
            {
              "type": "null"
            }
          ]
        },
        "gates": {
          "items": {
            "$ref": "#/$defs/ResearchGate"
          },
          "title": "Gates",
          "type": "array"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "attempts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RegisteredBacktest"
          },
          "title": "Attempts",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "plan",
        "outcome",
        "promotion_allowed",
        "selection",
        "folds",
        "holdout",
        "holdout_stress",
        "gates",
        "reasons"
      ],
      "title": "ResearchReport",
      "type": "object"
    },
    "report_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_lineage": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "role",
          "archive_id",
          "source_sha256",
          "dataset_fingerprint"
        ],
        "additionalProperties": false,
        "properties": {
          "role": {
            "enum": [
              "DEVELOPMENT",
              "HOLDOUT"
            ]
          },
          "archive_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "dataset_fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
