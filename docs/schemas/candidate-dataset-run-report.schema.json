{
  "$defs": {
    "CandidateDatasetRunManifest": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[a-f0-9]{32}$",
          "title": "Run Id",
          "type": "string"
        },
        "package_ref": {
          "pattern": "^validation-package:[a-f0-9]{64}$",
          "title": "Package Ref",
          "type": "string"
        },
        "candidate_ref": {
          "pattern": "^strategy-candidate:[a-f0-9]{64}$",
          "title": "Candidate Ref",
          "type": "string"
        },
        "row_count": {
          "maximum": 4096,
          "minimum": 2,
          "title": "Row Count",
          "type": "integer"
        },
        "parents": {
          "items": {
            "$ref": "#/$defs/PrefixReleaseDirectory"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Parents",
          "type": "array"
        },
        "image_inputs": {
          "$ref": "#/$defs/StrategyRunImageInputs"
        },
        "handoff": {
          "$ref": "#/$defs/StrategyImageHandoff"
        },
        "quantity": {
          "default": 1,
          "maximum": 500000,
          "minimum": 1,
          "title": "Quantity",
          "type": "integer"
        },
        "initial_balance": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 1000000000000.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "100000",
          "title": "Initial Balance"
        },
        "maximum_journal_bytes": {
          "const": 134217728,
          "default": 134217728,
          "title": "Maximum Journal Bytes",
          "type": "integer"
        },
        "maximum_recovery_bytes": {
          "const": 8589934592,
          "default": 8589934592,
          "title": "Maximum Recovery Bytes",
          "type": "integer"
        },
        "state": {
          "const": "DEVELOPMENT_WINDOW_RUN_PREPARED_UNATTESTED",
          "default": "DEVELOPMENT_WINDOW_RUN_PREPARED_UNATTESTED",
          "title": "State",
          "type": "string"
        },
        "execution_verified": {
          "const": false,
          "default": false,
          "title": "Execution Verified",
          "type": "boolean"
        },
        "promotion_allowed": {
          "const": false,
          "default": false,
          "title": "Promotion Allowed",
          "type": "boolean"
        },
        "dataset_window": {
          "$ref": "#/$defs/CandidateDatasetWindow"
        }
      },
      "required": [
        "run_id",
        "package_ref",
        "candidate_ref",
        "row_count",
        "parents",
        "image_inputs",
        "handoff",
        "dataset_window"
      ],
      "title": "CandidateDatasetRunManifest",
      "type": "object"
    },
    "CandidateDatasetWindow": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "package_ref": {
          "pattern": "^validation-package:[a-f0-9]{64}$",
          "title": "Package Ref",
          "type": "string"
        },
        "candidate_ref": {
          "pattern": "^strategy-candidate:[a-f0-9]{64}$",
          "title": "Candidate Ref",
          "type": "string"
        },
        "test_result_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Test Result Sha256",
          "type": "string"
        },
        "dataset_ref": {
          "pattern": "^research-data:[a-f0-9]{64}$",
          "title": "Dataset Ref",
          "type": "string"
        },
        "original_dataset_fingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Original Dataset Fingerprint",
          "type": "string"
        },
        "window_fingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Window Fingerprint",
          "type": "string"
        },
        "fold_index": {
          "maximum": 2047,
          "minimum": 0,
          "title": "Fold Index",
          "type": "integer"
        },
        "history_start": {
          "maximum": 4092,
          "minimum": 0,
          "title": "History Start",
          "type": "integer"
        },
        "validation_start": {
          "maximum": 4094,
          "minimum": 8,
          "title": "Validation Start",
          "type": "integer"
        },
        "validation_stop": {
          "maximum": 4096,
          "minimum": 9,
          "title": "Validation Stop",
          "type": "integer"
        },
        "complete_declared_window": {
          "title": "Complete Declared Window",
          "type": "boolean"
        },
        "resource_class": {
          "const": "TRAINING",
          "default": "TRAINING",
          "title": "Resource Class",
          "type": "string"
        },
        "purpose": {
          "const": "RETROSPECTIVE_DEVELOPMENT_WALK_FORWARD",
          "default": "RETROSPECTIVE_DEVELOPMENT_WALK_FORWARD",
          "title": "Purpose",
          "type": "string"
        },
        "selection_data_overlap": {
          "const": true,
          "default": true,
          "title": "Selection Data Overlap",
          "type": "boolean"
        },
        "statistical_independence": {
          "const": "UNASSESSED",
          "default": "UNASSESSED",
          "title": "Statistical Independence",
          "type": "string"
        },
        "isolation_verified": {
          "const": false,
          "default": false,
          "title": "Isolation Verified",
          "type": "boolean"
        },
        "promotion_allowed": {
          "const": false,
          "default": false,
          "title": "Promotion Allowed",
          "type": "boolean"
        }
      },
      "required": [
        "package_ref",
        "candidate_ref",
        "test_result_sha256",
        "dataset_ref",
        "original_dataset_fingerprint",
        "window_fingerprint",
        "fold_index",
        "history_start",
        "validation_start",
        "validation_stop",
        "complete_declared_window"
      ],
      "title": "CandidateDatasetWindow",
      "type": "object"
    },
    "CandidateTargetOutput": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "invocation_ref": {
          "pattern": "^candidate-invocation:[a-f0-9]{64}$",
          "title": "Invocation Ref",
          "type": "string"
        },
        "target": {
          "maximum": 1,
          "minimum": -1,
          "title": "Target",
          "type": "integer"
        },
        "status": {
          "const": "UNATTESTED_TARGET_OUTPUT",
          "default": "UNATTESTED_TARGET_OUTPUT",
          "title": "Status",
          "type": "string"
        },
        "isolation_verified": {
          "const": false,
          "default": false,
          "title": "Isolation Verified",
          "type": "boolean"
        },
        "promotion_authorized": {
          "const": false,
          "default": false,
          "title": "Promotion Authorized",
          "type": "boolean"
        }
      },
      "required": [
        "invocation_ref",
        "target"
      ],
      "title": "CandidateTargetOutput",
      "type": "object"
    },
    "ImageSourcePin": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "enum": [
            "worker.py",
            "base_image.json",
            "base_index.json",
            "base_manifest.json",
            "base_config.json"
          ],
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "ImageSourcePin",
      "type": "object"
    },
    "PrefixReleaseDirectory": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "identity": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "minimum": 0,
              "type": "integer"
            }
          ],
          "title": "Identity",
          "type": "array"
        }
      },
      "required": [
        "path",
        "identity"
      ],
      "title": "PrefixReleaseDirectory",
      "type": "object"
    },
    "SignalDecision": {
      "additionalProperties": false,
      "properties": {
        "execute_at": {
          "format": "date-time",
          "title": "Execute At",
          "type": "string"
        },
        "history_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "History Sha256",
          "type": "string"
        },
        "target": {
          "maximum": 1,
          "minimum": -1,
          "title": "Target",
          "type": "integer"
        }
      },
      "required": [
        "execute_at",
        "history_sha256",
        "target"
      ],
      "title": "SignalDecision",
      "type": "object"
    },
    "SignalReplayCosts": {
      "additionalProperties": false,
      "properties": {
        "spread_bps": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Spread Bps"
        },
        "slippage_bps": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Slippage Bps"
        },
        "commission_bps": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Commission Bps"
        },
        "multiplier": {
          "anyOf": [
            {
              "minimum": 1.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Multiplier"
        },
        "basis": {
          "const": "OPERATOR_DECLARED_SYNTHETIC",
          "default": "OPERATOR_DECLARED_SYNTHETIC",
          "title": "Basis",
          "type": "string"
        },
        "fee_model": {
          "const": "NATIVE_TAKER_NOTIONAL_QUOTE_CURRENCY",
          "default": "NATIVE_TAKER_NOTIONAL_QUOTE_CURRENCY",
          "title": "Fee Model",
          "type": "string"
        }
      },
      "required": [
        "spread_bps",
        "slippage_bps",
        "commission_bps",
        "multiplier"
      ],
      "title": "SignalReplayCosts",
      "type": "object"
    },
    "SignalReplayFill": {
      "additionalProperties": false,
      "properties": {
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "side": {
          "enum": [
            "BUY",
            "SELL"
          ],
          "title": "Side",
          "type": "string"
        },
        "price": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Price"
        },
        "quantity": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 1000000.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Quantity"
        },
        "fee": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Fee"
        }
      },
      "required": [
        "observed_at",
        "side",
        "price",
        "quantity",
        "fee"
      ],
      "title": "SignalReplayFill",
      "type": "object"
    },
    "SignalReplayReport": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "const": "UNATTESTED_NATIVE_REPLAY",
          "default": "UNATTESTED_NATIVE_REPLAY",
          "title": "Status",
          "type": "string"
        },
        "venue": {
          "const": "PAPER",
          "default": "PAPER",
          "title": "Venue",
          "type": "string"
        },
        "engine": {
          "const": "NAUTILUS_BACKTEST",
          "default": "NAUTILUS_BACKTEST",
          "title": "Engine",
          "type": "string"
        },
        "engine_version": {
          "const": "1.221.0",
          "default": "1.221.0",
          "title": "Engine Version",
          "type": "string"
        },
        "adapter_ref": {
          "const": "precomputed-signal-tape@0.1.0",
          "default": "precomputed-signal-tape@0.1.0",
          "title": "Adapter Ref",
          "type": "string"
        },
        "package_ref": {
          "pattern": "^validation-package:[a-f0-9]{64}$",
          "title": "Package Ref",
          "type": "string"
        },
        "tape": {
          "$ref": "#/$defs/SignalTape"
        },
        "instrument_id": {
          "enum": [
            "EURUSD",
            "GBPUSD",
            "USDJPY",
            "EURJPY"
          ],
          "title": "Instrument Id",
          "type": "string"
        },
        "pnl_currency": {
          "enum": [
            "USD",
            "JPY"
          ],
          "title": "Pnl Currency",
          "type": "string"
        },
        "account_currency_basis": {
          "const": "INSTRUMENT_QUOTE_ONLY",
          "default": "INSTRUMENT_QUOTE_ONLY",
          "title": "Account Currency Basis",
          "type": "string"
        },
        "bar_execution_model": {
          "const": "SYNTHETIC_OPEN_CLOSE_QUOTES_NEXT_OPEN_TARGETS",
          "default": "SYNTHETIC_OPEN_CLOSE_QUOTES_NEXT_OPEN_TARGETS",
          "title": "Bar Execution Model",
          "type": "string"
        },
        "synthetic_quote_size": {
          "const": 1000000,
          "default": 1000000,
          "title": "Synthetic Quote Size",
          "type": "integer"
        },
        "liquidity_basis": {
          "const": "FIXED_SYNTHETIC_SIZE_NOT_SOURCE_VOLUME_OR_BROKER_DEPTH",
          "default": "FIXED_SYNTHETIC_SIZE_NOT_SOURCE_VOLUME_OR_BROKER_DEPTH",
          "title": "Liquidity Basis",
          "type": "string"
        },
        "collateral_model": {
          "const": "FULL_TARGET_ASK_NOTIONAL_QUOTE_EQUITY_V1",
          "default": "FULL_TARGET_ASK_NOTIONAL_QUOTE_EQUITY_V1",
          "title": "Collateral Model",
          "type": "string"
        },
        "cost_scenario": {
          "enum": [
            "BASE",
            "DECLARED_STRESS"
          ],
          "title": "Cost Scenario",
          "type": "string"
        },
        "costs": {
          "$ref": "#/$defs/SignalReplayCosts"
        },
        "quantity": {
          "maximum": 500000,
          "minimum": 1,
          "title": "Quantity",
          "type": "integer"
        },
        "initial_balance": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 1000000000000.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Initial Balance"
        },
        "final_mark": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Final Mark"
        },
        "fills": {
          "items": {
            "$ref": "#/$defs/SignalReplayFill"
          },
          "maxItems": 4096,
          "title": "Fills",
          "type": "array"
        },
        "native_order_count": {
          "maximum": 4096,
          "minimum": 0,
          "title": "Native Order Count",
          "type": "integer"
        },
        "final_position": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Final Position"
        },
        "net_pnl": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Net Pnl"
        },
        "native_realized_pnl": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Native Realized Pnl"
        },
        "native_realized_pnl_verification": {
          "const": "NATIVE_CACHE_VALUE_NOT_INDEPENDENTLY_CHECKED",
          "default": "NATIVE_CACHE_VALUE_NOT_INDEPENDENTLY_CHECKED",
          "title": "Native Realized Pnl Verification",
          "type": "string"
        },
        "pnl_method": {
          "const": "FILL_CASHFLOWS_PLUS_FINAL_CLOSE_MARK_NOT_LIQUIDATION",
          "default": "FILL_CASHFLOWS_PLUS_FINAL_CLOSE_MARK_NOT_LIQUIDATION",
          "title": "Pnl Method",
          "type": "string"
        },
        "source_execution_status": {
          "const": "UNATTESTED",
          "default": "UNATTESTED",
          "title": "Source Execution Status",
          "type": "string"
        },
        "candidate_code_executed": {
          "const": false,
          "default": false,
          "title": "Candidate Code Executed",
          "type": "boolean"
        },
        "candidate_tests_status": {
          "const": "NOT_RUN",
          "default": "NOT_RUN",
          "title": "Candidate Tests Status",
          "type": "string"
        },
        "isolation_verified": {
          "const": false,
          "default": false,
          "title": "Isolation Verified",
          "type": "boolean"
        },
        "execution_authorized": {
          "const": false,
          "default": false,
          "title": "Execution Authorized",
          "type": "boolean"
        },
        "promotion_authorized": {
          "const": false,
          "default": false,
          "title": "Promotion Authorized",
          "type": "boolean"
        },
        "financing_costs": {
          "const": "UNAVAILABLE",
          "default": "UNAVAILABLE",
          "title": "Financing Costs",
          "type": "string"
        },
        "account_currency_conversion": {
          "const": "UNAVAILABLE",
          "default": "UNAVAILABLE",
          "title": "Account Currency Conversion",
          "type": "string"
        },
        "alpha_acceptance": {
          "const": "UNASSESSED",
          "default": "UNASSESSED",
          "title": "Alpha Acceptance",
          "type": "string"
        }
      },
      "required": [
        "package_ref",
        "tape",
        "instrument_id",
        "pnl_currency",
        "cost_scenario",
        "costs",
        "quantity",
        "initial_balance",
        "final_mark",
        "fills",
        "native_order_count",
        "final_position",
        "net_pnl",
        "native_realized_pnl"
      ],
      "title": "SignalReplayReport",
      "type": "object"
    },
    "SignalTape": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "package_ref": {
          "pattern": "^validation-package:[a-f0-9]{64}$",
          "title": "Package Ref",
          "type": "string"
        },
        "candidate_ref": {
          "pattern": "^strategy-candidate:[a-f0-9]{64}$",
          "title": "Candidate Ref",
          "type": "string"
        },
        "dataset_ref": {
          "pattern": "^research-data:[a-f0-9]{64}$",
          "title": "Dataset Ref",
          "type": "string"
        },
        "dataset_fingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Dataset Fingerprint",
          "type": "string"
        },
        "decisions": {
          "items": {
            "$ref": "#/$defs/SignalDecision"
          },
          "maxItems": 4096,
          "minItems": 2,
          "title": "Decisions",
          "type": "array"
        },
        "provenance": {
          "const": "OPERATOR_SUPPLIED_UNATTESTED_TARGETS",
          "default": "OPERATOR_SUPPLIED_UNATTESTED_TARGETS",
          "title": "Provenance",
          "type": "string"
        },
        "source_execution_status": {
          "const": "UNATTESTED",
          "default": "UNATTESTED",
          "title": "Source Execution Status",
          "type": "string"
        },
        "execution_timing": {
          "const": "NEXT_BAR_OPEN_AFTER_PREVIOUS_CLOSE_SIGNAL",
          "default": "NEXT_BAR_OPEN_AFTER_PREVIOUS_CLOSE_SIGNAL",
          "title": "Execution Timing",
          "type": "string"
        },
        "isolation_verified": {
          "const": false,
          "default": false,
          "title": "Isolation Verified",
          "type": "boolean"
        },
        "promotion_authorized": {
          "const": false,
          "default": false,
          "title": "Promotion Authorized",
          "type": "boolean"
        }
      },
      "required": [
        "package_ref",
        "candidate_ref",
        "dataset_ref",
        "dataset_fingerprint",
        "decisions"
      ],
      "title": "SignalTape",
      "type": "object"
    },
    "StrategyContainerExit": {
      "additionalProperties": false,
      "properties": {
        "container_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Container Id",
          "type": "string"
        },
        "status": {
          "const": "exited",
          "title": "Status",
          "type": "string"
        },
        "running": {
          "const": false,
          "title": "Running",
          "type": "boolean"
        },
        "paused": {
          "const": false,
          "title": "Paused",
          "type": "boolean"
        },
