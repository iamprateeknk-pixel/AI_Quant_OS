{
  "$defs": {
    "CandidateDatasetWindow": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "package_ref": {
          "pattern": "^validation-package:[a-f0-9]{64}$",
          "title": "Package Ref",
          "type": "string"
        },
        "candidate_ref": {
          "pattern": "^strategy-candidate:[a-f0-9]{64}$",
          "title": "Candidate Ref",
          "type": "string"
        },
        "test_result_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Test Result Sha256",
          "type": "string"
        },
        "dataset_ref": {
          "pattern": "^research-data:[a-f0-9]{64}$",
          "title": "Dataset Ref",
          "type": "string"
        },
        "original_dataset_fingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Original Dataset Fingerprint",
          "type": "string"
        },
        "window_fingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Window Fingerprint",
          "type": "string"
        },
        "fold_index": {
          "maximum": 2047,
          "minimum": 0,
          "title": "Fold Index",
          "type": "integer"
        },
        "history_start": {
          "maximum": 4092,
          "minimum": 0,
          "title": "History Start",
          "type": "integer"
        },
        "validation_start": {
          "maximum": 4094,
          "minimum": 8,
          "title": "Validation Start",
          "type": "integer"
        },
        "validation_stop": {
          "maximum": 4096,
          "minimum": 9,
          "title": "Validation Stop",
          "type": "integer"
        },
        "complete_declared_window": {
          "title": "Complete Declared Window",
          "type": "boolean"
        },
        "resource_class": {
          "const": "TRAINING",
          "default": "TRAINING",
          "title": "Resource Class",
          "type": "string"
        },
        "purpose": {
          "const": "RETROSPECTIVE_DEVELOPMENT_WALK_FORWARD",
          "default": "RETROSPECTIVE_DEVELOPMENT_WALK_FORWARD",
          "title": "Purpose",
          "type": "string"
        },
        "selection_data_overlap": {
          "const": true,
          "default": true,
          "title": "Selection Data Overlap",
          "type": "boolean"
        },
        "statistical_independence": {
          "const": "UNASSESSED",
          "default": "UNASSESSED",
          "title": "Statistical Independence",
          "type": "string"
        },
        "isolation_verified": {
          "const": false,
          "default": false,
          "title": "Isolation Verified",
          "type": "boolean"
        },
        "promotion_allowed": {
          "const": false,
          "default": false,
          "title": "Promotion Allowed",
          "type": "boolean"
        }
      },
      "required": [
        "package_ref",
        "candidate_ref",
        "test_result_sha256",
        "dataset_ref",
        "original_dataset_fingerprint",
        "window_fingerprint",
        "fold_index",
        "history_start",
        "validation_start",
        "validation_stop",
        "complete_declared_window"
      ],
      "title": "CandidateDatasetWindow",
      "type": "object"
    },
    "ImageSourcePin": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "enum": [
            "worker.py",
            "base_image.json",
            "base_index.json",
            "base_manifest.json",
            "base_config.json"
          ],
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "ImageSourcePin",
      "type": "object"
    },
    "PrefixReleaseDirectory": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "identity": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "minimum": 0,
              "type": "integer"
            }
          ],
          "title": "Identity",
          "type": "array"
        }
      },
      "required": [
        "path",
        "identity"
      ],
      "title": "PrefixReleaseDirectory",
      "type": "object"
    },
    "StrategyImageHandoff": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "state": {
          "enum": [
            "IMAGE_LOAD_INSPECTED",
            "IMAGE_PRESENT_INSPECTED"
          ],
          "title": "State",
          "type": "string"
        },
        "archive": {
          "$ref": "#/$defs/StrategyWorkerImageReceipt"
        },
        "loaded_image_id": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Loaded Image Id",
          "type": "string"
        },
        "engine_id": {
          "pattern": "^[A-Za-z0-9:_-]{1,128}$",
          "title": "Engine Id",
          "type": "string"
        },
        "api_version": {
          "pattern": "^1\\.[0-9]{1,3}$",
          "title": "Api Version",
          "type": "string"
        },
        "engine_metadata_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Engine Metadata Sha256",
          "type": "string"
        },
        "image_metadata_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Image Metadata Sha256",
          "type": "string"
        },
        "execution_verified": {
          "const": false,
          "default": false,
          "title": "Execution Verified",
          "type": "boolean"
        },
        "promotion_allowed": {
          "const": false,
          "default": false,
          "title": "Promotion Allowed",
          "type": "boolean"
        }
      },
      "required": [
        "state",
        "archive",
        "loaded_image_id",
        "engine_id",
        "api_version",
        "engine_metadata_sha256",
        "image_metadata_sha256"
      ],
      "title": "StrategyImageHandoff",
      "type": "object"
    },
    "StrategyRunImageInputs": {
      "additionalProperties": false,
      "properties": {
        "archive": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Archive",
          "type": "string"
        },
        "base_metadata": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Base Metadata",
          "type": "string"
        },
        "base_manifest_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Base Manifest Digest",
          "type": "string"
        },
        "worker_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Worker Sha256",
          "type": "string"
        },
        "archive_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Archive Sha256",
          "type": "string"
        },
        "manifest_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Manifest Digest",
          "type": "string"
        },
        "config_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Config Digest",
          "type": "string"
        }
      },
      "required": [
        "archive",
        "base_metadata",
        "base_manifest_digest",
        "worker_sha256",
        "archive_sha256",
        "manifest_digest",
        "config_digest"
      ],
      "title": "StrategyRunImageInputs",
      "type": "object"
    },
    "StrategyWorkerImageReceipt": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "state": {
          "default": "OCI_ARCHIVE_ONLY",
          "enum": [
            "OCI_ARCHIVE_ONLY",
            "ARCHIVE_HASHES_VERIFIED"
          ],
          "title": "State",
          "type": "string"
        },
        "platform": {
          "const": "linux/amd64",
          "default": "linux/amd64",
          "title": "Platform",
          "type": "string"
        },
        "python_version": {
          "const": "3.11.17",
          "default": "3.11.17",
          "title": "Python Version",
          "type": "string"
        },
        "base_manifest_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Base Manifest Digest",
          "type": "string"
        },
        "worker_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Worker Sha256",
          "type": "string"
        },
        "source_pins": {
          "items": {
            "$ref": "#/$defs/ImageSourcePin"
          },
          "maxItems": 5,
          "minItems": 5,
          "title": "Source Pins",
          "type": "array"
        },
        "manifest_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Manifest Digest",
          "type": "string"
        },
        "config_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Config Digest",
          "type": "string"
        },
        "worker_layer_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Worker Layer Digest",
          "type": "string"
        },
        "archive_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Archive Sha256",
          "type": "string"
        },
        "archive_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 134217728,
          "title": "Archive Bytes",
          "type": "integer"
        },
        "archive_integrity_verified": {
          "default": false,
          "title": "Archive Integrity Verified",
          "type": "boolean"
        },
        "image_verified": {
          "const": false,
          "default": false,
          "title": "Image Verified",
          "type": "boolean"
        },
        "execution_verified": {
          "const": false,
          "default": false,
          "title": "Execution Verified",
          "type": "boolean"
        },
        "promotion_allowed": {
          "const": false,
          "default": false,
          "title": "Promotion Allowed",
          "type": "boolean"
        },
        "source_execution_status": {
          "const": "NOT_RUN",
          "default": "NOT_RUN",
          "title": "Source Execution Status",
          "type": "string"
        }
      },
      "required": [
        "base_manifest_digest",
        "worker_sha256",
        "source_pins",
        "manifest_digest",
        "config_digest",
        "worker_layer_digest",
        "archive_sha256",
        "archive_bytes"
      ],
      "title": "StrategyWorkerImageReceipt",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[a-f0-9]{32}$",
      "title": "Run Id",
      "type": "string"
    },
    "package_ref": {
      "pattern": "^validation-package:[a-f0-9]{64}$",
      "title": "Package Ref",
      "type": "string"
    },
    "candidate_ref": {
      "pattern": "^strategy-candidate:[a-f0-9]{64}$",
      "title": "Candidate Ref",
      "type": "string"
    },
    "row_count": {
      "maximum": 4096,
      "minimum": 2,
      "title": "Row Count",
      "type": "integer"
    },
    "parents": {
      "items": {
        "$ref": "#/$defs/PrefixReleaseDirectory"
      },
      "maxItems": 128,
      "minItems": 1,
      "title": "Parents",
      "type": "array"
    },
    "image_inputs": {
      "$ref": "#/$defs/StrategyRunImageInputs"
    },
    "handoff": {
      "$ref": "#/$defs/StrategyImageHandoff"
    },
    "quantity": {
      "default": 1,
      "maximum": 500000,
      "minimum": 1,
      "title": "Quantity",
      "type": "integer"
    },
    "initial_balance": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "maximum": 1000000000000.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "default": "100000",
      "title": "Initial Balance"
    },
    "maximum_journal_bytes": {
      "const": 134217728,
      "default": 134217728,
      "title": "Maximum Journal Bytes",
      "type": "integer"
    },
    "maximum_recovery_bytes": {
      "const": 8589934592,
      "default": 8589934592,
      "title": "Maximum Recovery Bytes",
      "type": "integer"
    },
    "state": {
      "const": "DEVELOPMENT_WINDOW_RUN_PREPARED_UNATTESTED",
      "default": "DEVELOPMENT_WINDOW_RUN_PREPARED_UNATTESTED",
      "title": "State",
      "type": "string"
    },
    "execution_verified": {
      "const": false,
      "default": false,
      "title": "Execution Verified",
      "type": "boolean"
    },
    "promotion_allowed": {
      "const": false,
      "default": false,
      "title": "Promotion Allowed",
      "type": "boolean"
    },
    "dataset_window": {
      "$ref": "#/$defs/CandidateDatasetWindow"
    }
  },
  "required": [
    "run_id",
    "package_ref",
    "candidate_ref",
    "row_count",
    "parents",
    "image_inputs",
    "handoff",
    "dataset_window"
  ],
  "title": "CandidateDatasetRunManifest",
  "type": "object"
}
