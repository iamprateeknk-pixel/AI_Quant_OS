        "quantity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$",
              "type": "string"
            }
          ],
