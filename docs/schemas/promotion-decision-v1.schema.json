{
  "$defs": {
    "PromotionEvaluation": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "NOT_RUN",
            "UNAVAILABLE",
            "PASS",
            "FAIL"
          ],
          "title": "Status",
          "type": "string"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Evidence Refs",
          "type": "array"
        },
        "evaluated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evaluated At"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "status"
      ],
      "title": "PromotionEvaluation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Promotion evidence snapshot that cannot authorize promotion in this release.",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "candidate_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Candidate Id",
      "type": "string"
    },
    "current_champion_id": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Current Champion Id"
    },
    "offline_eval": {
      "$ref": "#/$defs/PromotionEvaluation"
    },
    "replay_eval": {
      "$ref": "#/$defs/PromotionEvaluation"
    },
    "adversarial_eval": {
      "$ref": "#/$defs/PromotionEvaluation"
    },
    "shadow_eval": {
      "$ref": "#/$defs/PromotionEvaluation"
    },
    "canary_eval": {
      "$ref": "#/$defs/PromotionEvaluation"
    },
    "decision": {
      "const": "WAIT_FOR_EVIDENCE",
      "default": "WAIT_FOR_EVIDENCE",
      "title": "Decision",
      "type": "string"
    },
    "rollback_target": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rollback Target"
    },
    "approved_by_policy": {
      "const": false,
      "default": false,
      "title": "Approved By Policy",
      "type": "boolean"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "candidate_id",
    "offline_eval",
    "replay_eval",
    "adversarial_eval",
    "shadow_eval",
    "canary_eval",
    "created_at"
  ],
  "title": "PromotionDecision",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-quant-os:promotion-decision:1.0"
}
