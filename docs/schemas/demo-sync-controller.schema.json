{
  "$defs": {
    "SyncHealth": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "observation_kind": {
          "const": "DEMO_SYNC_HEALTH",
          "default": "DEMO_SYNC_HEALTH",
          "title": "Observation Kind",
          "type": "string"
        },
        "state": {
          "enum": [
            "DISABLED",
            "STARTING",
            "ACTIVE",
            "HEALTHY",
            "DEGRADED",
            "HALTED"
          ],
          "title": "State",
          "type": "string"
        },
        "code": {
          "anyOf": [
            {
              "enum": [
                "STORAGE_UNAVAILABLE",
                "CLOCK_REGRESSION",
                "HISTORY_GAP",
                "CUSTODY_UNCERTAIN",
                "SOURCE_FAILURE",
                "PROJECTION_FAILURE",
                "CAPACITY"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        },
        "revision": {
          "default": 0,
          "maximum": 3000,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "next_due_at": {
          "format": "date-time",
          "title": "Next Due At",
          "type": "string"
        },
        "last_history_end": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last History End"
        },
        "last_success_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Success At"
        },
        "consecutive_failures": {
          "default": 0,
          "maximum": 3000,
          "minimum": 0,
          "title": "Consecutive Failures",
          "type": "integer"
        },
        "pending_attempt_id": {
          "anyOf": [
            {
              "format": "uuid4",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pending Attempt Id"
        },
        "pending_history_start": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pending History Start"
        },
        "pending_history_end": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pending History End"
        },
        "may_submit_orders": {
          "const": false,
          "default": false,
          "title": "May Submit Orders",
          "type": "boolean"
        },
        "may_affect_portfolio": {
          "const": false,
          "default": false,
          "title": "May Affect Portfolio",
          "type": "boolean"
        },
        "native_attestation": {
          "const": "UNVERIFIED",
          "default": "UNVERIFIED",
          "title": "Native Attestation",
          "type": "string"
        }
      },
      "required": [
        "state",
        "observed_at",
        "next_due_at"
      ],
      "title": "SyncHealth",
      "type": "object"
    },
    "SyncSchedule": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "initial_history_start": {
          "format": "date-time",
          "title": "Initial History Start",
          "type": "string"
        },
        "interval_seconds": {
          "default": 10,
          "maximum": 3600,
          "minimum": 5,
          "title": "Interval Seconds",
          "type": "integer"
        },
        "overlap_seconds": {
          "default": 60,
          "maximum": 3600,
          "minimum": 1,
          "title": "Overlap Seconds",
          "type": "integer"
        },
        "max_backoff_seconds": {
          "default": 300,
          "maximum": 3600,
          "minimum": 5,
          "title": "Max Backoff Seconds",
          "type": "integer"
        }
      },
      "required": [
        "initial_history_start"
      ],
      "title": "SyncSchedule",
      "type": "object"
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/SyncSchedule"
    },
    {
      "$ref": "#/$defs/SyncHealth"
    }
  ]
}
