      "title": "Schema Version",
      "type": "string"
    },
    "mode": {
      "const": "PAPER",
      "title": "Mode",
      "type": "string"
    },
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "ledger_sha256": {
      "title": "Ledger Sha256",
      "type": "string"
    },
    "benchmarks_sha256": {
      "title": "Benchmarks Sha256",
      "type": "string"
    },
    "benchmark_method": {
      "const": "INITIAL_DECISION_MID_SIDE_QUOTE_V1",
      "title": "Benchmark Method",
      "type": "string"
    },
    "coverage": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "NONE",
        "EMPTY"
      ],
      "title": "Coverage",
      "type": "string"
    },
    "strategies": {
      "items": {
        "$ref": "#/$defs/StrategyExecutionContribution"
      },
      "title": "Strategies",
      "type": "array"
    },
    "instruments": {
