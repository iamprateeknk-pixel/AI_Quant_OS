{
  "$defs": {
    "InstrumentExecutionContribution": {
      "properties": {
        "fill_count": {
          "title": "Fill Count",
          "type": "integer"
        },
        "benchmark_fill_count": {
          "title": "Benchmark Fill Count",
          "type": "integer"
        },
        "reference_mid_cash_flow_quote": {
          "anyOf": [
            {
              "pattern": "^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reference Mid Cash Flow Quote"
        },
        "spread_cash_adjustment_quote": {
          "anyOf": [
            {
              "pattern": "^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Spread Cash Adjustment Quote"
        },
        "decision_to_fill_cash_adjustment_quote": {
          "anyOf": [
            {
              "pattern": "^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Decision To Fill Cash Adjustment Quote"
        },
        "fee_cash_flow_quote": {
          "pattern": "^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$",
          "title": "Fee Cash Flow Quote",
          "type": "string"
        },
        "actual_cash_flow_quote": {
          "pattern": "^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$",
          "title": "Actual Cash Flow Quote",
          "type": "string"
        },
        "instrument_id": {
          "title": "Instrument Id",
          "type": "string"
        },
        "quote_currency": {
          "title": "Quote Currency",
          "type": "string"
        }
      },
      "required": [
        "fill_count",
        "benchmark_fill_count",
        "reference_mid_cash_flow_quote",
        "spread_cash_adjustment_quote",
        "decision_to_fill_cash_adjustment_quote",
        "fee_cash_flow_quote",
        "actual_cash_flow_quote",
        "instrument_id",
        "quote_currency"
      ],
      "title": "InstrumentExecutionContribution",
      "type": "object"
    },
