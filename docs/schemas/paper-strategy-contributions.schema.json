        "instrument_id": {
          "title": "Instrument Id",
          "type": "string"
        },
        "quote_currency": {
          "title": "Quote Currency",
          "type": "string"
        },
        "mark_price": {
          "anyOf": [
            {
              "pattern": "^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mark Price"
        },
        "mark_state": {
          "title": "Mark State",
          "type": "string"
        }
