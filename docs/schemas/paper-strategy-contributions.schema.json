    "InstrumentContribution": {
      "properties": {
        "fill_count": {
          "title": "Fill Count",
          "type": "integer"
        },
        "net_quantity": {
          "pattern": "^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$",
          "title": "Net Quantity",
          "type": "string"
        },
        "cash_flow_before_fees_quote": {
          "pattern": "^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$",
          "title": "Cash Flow Before Fees Quote",
          "type": "string"
        },
