{
  "additionalProperties": false,
  "properties": {
    "index": {
      "maximum": 2050,
      "minimum": 0,
      "title": "Index",
      "type": "integer"
    },
    "stage": {
      "pattern": "^(TESTS|HOLDOUT|DEVELOPMENT:[0-9]{1,4}|PUBLICATION)$",
      "title": "Stage",
      "type": "string"
    },
    "phase": {
      "enum": [
        "RESERVED",
        "PREPARED",
        "COMPLETED",
        "UNCERTAIN",
        "PAUSED"
      ],
      "title": "Phase",
      "type": "string"
    },
    "attempt": {
      "default": 0,
      "maximum": 16,
      "minimum": 0,
      "title": "Attempt",
      "type": "integer"
    },
    "manifest_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Manifest Sha256"
    },
    "result_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result Sha256"
    },
    "test_status": {
      "anyOf": [
        {
          "enum": [
            "COMPILE_FAILED",
            "PROPOSED_TESTS_PASSED_UNATTESTED",
            "PROPOSED_TESTS_FAILED_UNATTESTED"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Test Status"
    },
    "artifact_ref": {
      "anyOf": [
        {
          "pattern": "^candidate-(validation|prerequisite-failure):[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Artifact Ref"
    },
    "reason": {
      "anyOf": [
        {
          "enum": [
            "STAGE_OUTCOME_UNCONFIRMED",
            "COOPERATIVE_STOP_AFTER_OWNED_PREFIX"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "promotion_allowed": {
      "const": false,
      "default": false,
      "title": "Promotion Allowed",
      "type": "boolean"
    }
  },
  "required": [
    "index",
    "stage",
    "phase"
  ],
  "title": "ValidationStageRecord",
  "type": "object"
}
