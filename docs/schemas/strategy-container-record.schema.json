{
  "$defs": {
    "StrategyContainerOwnership": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "owner": {
          "pattern": "^[a-f0-9]{32}$",
          "title": "Owner",
          "type": "string"
        },
        "job_path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Job Path",
          "type": "string"
        },
        "job_name": {
          "pattern": "^strategy-job-[a-f0-9]{32}$",
          "title": "Job Name",
          "type": "string"
        },
        "invocation_ref": {
          "pattern": "^candidate-invocation:[a-f0-9]{64}$",
          "title": "Invocation Ref",
          "type": "string"
        },
        "stage_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Stage Sha256",
          "type": "string"
        },
        "image_id": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Image Id",
          "type": "string"
        },
        "worker_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Worker Sha256",
          "type": "string"
        },
        "execution_verified": {
          "const": false,
          "default": false,
          "title": "Execution Verified",
          "type": "boolean"
        },
        "promotion_allowed": {
          "const": false,
          "default": false,
          "title": "Promotion Allowed",
          "type": "boolean"
        }
      },
      "required": [
        "owner",
        "job_path",
        "job_name",
        "invocation_ref",
        "stage_sha256",
        "image_id",
        "worker_sha256"
      ],
      "title": "StrategyContainerOwnership",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "ownership": {
      "$ref": "#/$defs/StrategyContainerOwnership"
    },
    "state": {
      "enum": [
        "CREATE_INTENT",
        "CREATE_ACK",
        "REMOVE_INTENT",
        "REMOVED"
      ],
      "title": "State",
      "type": "string"
    },
    "container_id": {
      "pattern": "^(?:[a-f0-9]{64})?$",
      "title": "Container Id",
      "type": "string"
    },
    "execution_verified": {
      "const": false,
      "default": false,
      "title": "Execution Verified",
      "type": "boolean"
    },
    "promotion_allowed": {
      "const": false,
      "default": false,
      "title": "Promotion Allowed",
      "type": "boolean"
    }
  },
  "required": [
    "ownership",
    "state",
    "container_id"
  ],
  "title": "StrategyContainerRecord",
  "type": "object"
}
