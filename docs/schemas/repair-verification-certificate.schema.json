{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-quant-os.local/schemas/repair-verification-certificate.schema.json",
  "title": "Signed repair behavioral verification certificate",
  "description": "An Ed25519-signed, source-bound result from an externally trusted verifier. A valid certificate never grants promotion authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["certificate", "signature"],
  "properties": {
    "certificate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "verifier_id", "verifier_source_sha256", "suite_sha256",
        "image_id", "candidate_id", "candidate_commit", "rollback_commit",
        "snapshot_sha256", "request_sha256", "incident_id", "agent_id", "old_version", "new_version",
        "replay_sha256", "issued_at", "verdict", "test_results", "promotion_allowed"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "verifier_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "verifier_source_sha256": {"$ref": "#/$defs/digest"},
        "suite_sha256": {"$ref": "#/$defs/digest"},
        "image_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "candidate_id": {"$ref": "#/$defs/digest"},
        "candidate_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "rollback_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "snapshot_sha256": {"$ref": "#/$defs/digest"},
        "request_sha256": {"$ref": "#/$defs/digest"},
        "incident_id": {"$ref": "#/$defs/digest"},
        "agent_id": {"type": "string", "pattern": "^A(0[1-9]|1[0-8])$"},
        "old_version": {"type": "string", "pattern": "^[0-9]{1,6}\\.[0-9]{1,6}\\.[0-9]{1,6}$"},
        "new_version": {"type": "string", "pattern": "^[0-9]{1,6}\\.[0-9]{1,6}\\.[0-9]{1,6}$"},
        "replay_sha256": {"$ref": "#/$defs/digest"},
        "issued_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "verdict": {"enum": ["PASS", "FAIL"]},
        "test_results": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["test_id", "status", "evidence_sha256"],
            "properties": {
              "test_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
              "status": {"enum": ["PASS", "FAIL"]},
              "evidence_sha256": {"$ref": "#/$defs/digest"}
            }
          }
        },
        "promotion_allowed": {"const": false}
      }
    },
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
