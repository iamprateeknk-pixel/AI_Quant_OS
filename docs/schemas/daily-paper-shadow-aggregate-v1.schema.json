  "properties": {
    "start_day": {
      "format": "date",
      "title": "Start Day",
      "type": "string"
    },
    "end_day": {
      "format": "date",
      "title": "End Day",
      "type": "string"
    },
    "shadow_id": {
      "title": "Shadow Id",
      "type": "string"
    },
    "days": {
      "items": {
        "$ref": "#/$defs/DailyPaperShadowDay"
      },
      "title": "Days",
      "type": "array"
    },
    "covered_days": {
      "items": {
        "format": "date",
        "type": "string"
      },
      "title": "Covered Days",
      "type": "array"
    },
    "missing_days": {
      "items": {
        "format": "date",
        "type": "string"
      },
      "title": "Missing Days",
      "type": "array"
    },
    "totals": {
      "anyOf": [
        {
          "$ref": "#/$defs/DailyPaperShadowTotals"
        },
        {
          "type": "null"
        }
      ]
    },
    "coverage": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "NO_EVIDENCE"
      ],
      "title": "Coverage",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "mode": {
      "const": "PAPER_SHADOW_DIAGNOSTIC",
      "default": "PAPER_SHADOW_DIAGNOSTIC",
      "title": "Mode",
      "type": "string"
    },
    "promotion_allowed": {
      "const": false,
      "default": false,
      "title": "Promotion Allowed",
      "type": "boolean"
    },
    "causal_attribution_allowed": {
      "const": false,
      "default": false,
      "title": "Causal Attribution Allowed",
      "type": "boolean"
    }
  },
  "required": [
    "start_day",
    "end_day",
    "shadow_id",
    "days",
    "covered_days",
    "missing_days",
    "totals",
    "coverage"
  ],
  "title": "DailyPaperShadowAggregate",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-quant-os:contract:daily-paper-shadow-aggregate:1.0"
