          ],
          "title": "Shadow Minus Paper Fee Cash Flow Quote"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "mode": {
          "const": "PAPER_SHADOW_DIAGNOSTIC",
          "default": "PAPER_SHADOW_DIAGNOSTIC",
          "title": "Mode",
          "type": "string"
        },
        "promotion_allowed": {
          "const": false,
          "default": false,
          "title": "Promotion Allowed",
          "type": "boolean"
        },
        "causal_attribution_allowed": {
          "const": false,
          "default": false,
          "title": "Causal Attribution Allowed",
          "type": "boolean"
        }
      },
      "required": [
