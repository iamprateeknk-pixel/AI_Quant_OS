{
  "$defs": {
    "DailyPaperShadowDay": {
      "properties": {
        "day": {
          "format": "date",
          "title": "Day",
          "type": "string"
        },
        "comparison": {
          "anyOf": [
            {
              "$ref": "#/$defs/PaperShadowComparison"
            },
            {
              "type": "null"
            }
          ]
        },
        "missing_reason": {
          "anyOf": [
            {
              "enum": [
                "DAILY_EXECUTION_MISSING",
                "SHADOW_EVIDENCE_MISSING",
                "PRE_DAY_BASELINE_MISSING",
                "CROSS_DAY_BATCH"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Missing Reason"
        }
      },
      "required": [
        "day",
        "comparison",
        "missing_reason"
      ],
      "title": "DailyPaperShadowDay",
      "type": "object"
    },
    "DailyPaperShadowTotals": {
      "properties": {
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "genome_sha256": {
          "title": "Genome Sha256",
          "type": "string"
        },
        "strategy_ref": {
          "title": "Strategy Ref",
          "type": "string"
        },
        "instrument_id": {
          "title": "Instrument Id",
          "type": "string"
        },
        "quote_currency": {
          "title": "Quote Currency",
          "type": "string"
        },
        "compared_day_count": {
          "title": "Compared Day Count",
          "type": "integer"
        },
        "paper_fill_count": {
          "title": "Paper Fill Count",
          "type": "integer"
        },
        "shadow_fill_count": {
          "title": "Shadow Fill Count",
          "type": "integer"
        },
        "paper_cash_flow_quote": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Paper Cash Flow Quote"
        },
        "shadow_cash_flow_quote": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Shadow Cash Flow Quote"
        },
        "shadow_minus_paper_cash_flow_quote": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Shadow Minus Paper Cash Flow Quote"
        },
        "paper_fee_cash_flow_quote": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Paper Fee Cash Flow Quote"
        },
        "shadow_fee_cash_flow_quote": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Shadow Fee Cash Flow Quote"
        },
        "shadow_minus_paper_fee_cash_flow_quote": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Shadow Minus Paper Fee Cash Flow Quote"
        }
      },
      "required": [
        "candidate_id",
        "genome_sha256",
        "strategy_ref",
        "instrument_id",
        "quote_currency",
        "compared_day_count",
        "paper_fill_count",
        "shadow_fill_count",
        "paper_cash_flow_quote",
        "shadow_cash_flow_quote",
        "shadow_minus_paper_cash_flow_quote",
        "paper_fee_cash_flow_quote",
        "shadow_fee_cash_flow_quote",
        "shadow_minus_paper_fee_cash_flow_quote"
      ],
      "title": "DailyPaperShadowTotals",
      "type": "object"
    },
