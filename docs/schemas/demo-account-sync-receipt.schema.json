    "DemoSyncReport": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "observation_kind": {
          "const": "ACCOUNT_SYNC",
          "default": "ACCOUNT_SYNC",
          "title": "Observation Kind",
          "type": "string"
        },
        "broker_id": {
          "const": "EXNESS_MT5_DEMO",
          "default": "EXNESS_MT5_DEMO",
          "title": "Broker Id",
          "type": "string"
        },
        "state": {
          "enum": [
            "DISABLED",
            "WITHHELD",
            "CAPTURED"
          ],
          "title": "State",
          "type": "string"
        },
        "code": {
          "anyOf": [
            {
              "enum": [
                "DISABLED",
                "SDK_VERSION",
                "CONNECTION",
                "ACCOUNT",
                "QUOTE",
                "CLOCK",
                "NATIVE_FAILURE",
                "CLEANUP_FAILURE",
                "HISTORY_WINDOW",
                "DATA_UNAVAILABLE",
                "DATA_INVALID",
                "UNMAPPED_SYMBOL",
                "CAPACITY",
                "RESULT_LIMIT"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Code"
        },
        "batch": {
          "anyOf": [
            {
              "$ref": "#/$defs/SyncBatch"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "trace_id": {
          "format": "uuid4",
          "title": "Trace Id",
          "type": "string"
        },
        "may_submit_orders": {
          "const": false,
          "default": false,
          "title": "May Submit Orders",
          "type": "boolean"
        },
        "may_affect_portfolio": {
          "const": false,
          "default": false,
          "title": "May Affect Portfolio",
          "type": "boolean"
        },
        "native_attestation": {
          "const": "UNVERIFIED",
          "default": "UNVERIFIED",
          "title": "Native Attestation",
          "type": "string"
        }
      },
      "required": [
        "state",
        "code"
      ],
      "title": "DemoSyncReport",
      "type": "object"
    },
