{
  "$defs": {
    "CaseDiagnostic": {
      "additionalProperties": false,
      "description": "Case-level correctness tags; source inputs and outputs are not retained.",
      "properties": {
        "case_id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Case Id",
          "type": "string"
        },
        "baseline_correct": {
          "title": "Baseline Correct",
          "type": "boolean"
        },
        "challenger_correct": {
          "title": "Challenger Correct",
          "type": "boolean"
        },
        "weakness_categories": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "REGIME_LABEL_MISMATCH",
                  "REGIME_EVIDENCE_MISMATCH",
                  "REGIME_DISTRIBUTION_MISMATCH",
                  "INTEGRITY_STATUS_MISMATCH",
                  "INSTRUMENT_FINDINGS_MISMATCH",
                  "QUARANTINE_SET_MISMATCH",
                  "INGRESS_COUNTS_MISMATCH",
                  "CLOCK_EVIDENCE_MISMATCH",
                  "CONTRADICTION_SET_MISMATCH",
                  "OUTPUT_SHAPE_MISMATCH",
                  "OTHER_VALUE_MISMATCH"
                ],
                "type": "string"
              },
              "maxItems": 8,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weakness Categories"
        }
      },
      "required": [
        "case_id",
        "baseline_correct",
        "challenger_correct"
      ],
      "title": "CaseDiagnostic",
      "type": "object"
    },
    "MetricComparison": {
      "additionalProperties": false,
      "properties": {
        "metric": {
          "enum": [
            "CORRECTNESS",
            "REGIME_CORRECTNESS",
            "INTEGRITY_CORRECTNESS"
          ],
          "title": "Metric",
          "type": "string"
        },
        "baseline_score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Baseline Score"
        },
        "challenger_score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Challenger Score"
        },
        "case_count": {
          "maximum": 128,
          "minimum": 1,
          "title": "Case Count",
          "type": "integer"
        },
        "baseline_exact_matches": {
          "maximum": 128,
          "minimum": 0,
          "title": "Baseline Exact Matches",
          "type": "integer"
        },
        "challenger_exact_matches": {
          "maximum": 128,
          "minimum": 0,
          "title": "Challenger Exact Matches",
          "type": "integer"
        },
        "maximum_regression": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Maximum Regression"
        },
        "within_guardrail": {
          "title": "Within Guardrail",
          "type": "boolean"
        }
      },
      "required": [
        "metric",
        "baseline_score",
        "challenger_score",
        "case_count",
        "baseline_exact_matches",
        "challenger_exact_matches",
        "maximum_regression",
        "within_guardrail"
      ],
      "title": "MetricComparison",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.3",
      "enum": [
        "1.0",
        "1.1",
        "1.2",
        "1.3"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "const": "TRAINING_DIAGNOSTIC",
      "default": "TRAINING_DIAGNOSTIC",
      "title": "Scope",
      "type": "string"
    },
    "diagnostic": {
      "enum": [
        "IMPROVES_ON_TRAINING_DATA",
        "NO_IMPROVEMENT",
        "GUARDRAIL_REGRESSION"
      ],
      "title": "Diagnostic",
      "type": "string"
    },
    "dataset_ref": {
      "pattern": "^evolution-dataset:[a-f0-9]{64}$",
      "title": "Dataset Ref",
      "type": "string"
    },
    "dataset_provenance": {
      "enum": [
        "SYNTHETIC_DEVELOPMENT_NOT_HOLDOUT",
        "RECORDED_REFERENCE",
        "REVIEWED_REFERENCE"
      ],
      "title": "Dataset Provenance",
      "type": "string"
    },
    "protocol_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Protocol Sha256",
      "type": "string"
    },
    "baseline_genome_ref": {
      "pattern": "^agent-genome:[a-f0-9]{64}$",
      "title": "Baseline Genome Ref",
      "type": "string"
    },
    "challenger_genome_ref": {
      "pattern": "^agent-genome:[a-f0-9]{64}$",
      "title": "Challenger Genome Ref",
      "type": "string"
    },
    "primary_metric": {
      "enum": [
        "CORRECTNESS",
        "REGIME_CORRECTNESS",
        "INTEGRITY_CORRECTNESS"
      ],
      "title": "Primary Metric",
      "type": "string"
    },
    "baseline_score": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Baseline Score"
    },
    "challenger_score": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Challenger Score"
    },
    "case_count": {
      "maximum": 128,
      "minimum": 1,
      "title": "Case Count",
      "type": "integer"
    },
    "baseline_exact_matches": {
      "maximum": 128,
      "minimum": 0,
      "title": "Baseline Exact Matches",
      "type": "integer"
    },
    "challenger_exact_matches": {
      "maximum": 128,
      "minimum": 0,
      "title": "Challenger Exact Matches",
      "type": "integer"
    },
    "minimum_improvement": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Minimum Improvement"
    },
    "minimum_improvement_met": {
      "title": "Minimum Improvement Met",
      "type": "boolean"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/MetricComparison"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Metrics",
      "type": "array"
    },
    "case_diagnostics": {
      "items": {
        "$ref": "#/$defs/CaseDiagnostic"
      },
      "maxItems": 128,
      "minItems": 1,
      "title": "Case Diagnostics",
      "type": "array"
    },
    "evaluated_at": {
      "format": "date-time",
      "title": "Evaluated At",
      "type": "string"
    },
    "evaluation_verified": {
      "const": false,
      "default": false,
      "title": "Evaluation Verified",
      "type": "boolean"
    },
    "promotion_allowed": {
      "const": false,
      "default": false,
      "title": "Promotion Allowed",
      "type": "boolean"
    }
  },
  "required": [
    "diagnostic",
    "dataset_ref",
    "dataset_provenance",
    "protocol_sha256",
    "baseline_genome_ref",
    "challenger_genome_ref",
    "primary_metric",
    "baseline_score",
    "challenger_score",
    "case_count",
    "baseline_exact_matches",
    "challenger_exact_matches",
    "minimum_improvement",
    "minimum_improvement_met",
    "metrics",
    "case_diagnostics",
    "evaluated_at"
  ],
  "title": "EvolutionScorecard",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-quant-os:evolution-scorecard:1.3",
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.0"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "properties": {
          "case_diagnostics": {
            "items": {
              "properties": {
                "weakness_categories": {
                  "type": "null"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "enum": [
              "1.1",
              "1.2",
              "1.3"
            ]
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "properties": {
          "case_diagnostics": {
            "items": {
              "required": [
                "weakness_categories"
              ],
              "properties": {
                "weakness_categories": {
                  "type": "array",
                  "maxItems": 8,
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "REGIME_LABEL_MISMATCH",
                      "REGIME_EVIDENCE_MISMATCH",
                      "REGIME_DISTRIBUTION_MISMATCH",
                      "INTEGRITY_STATUS_MISMATCH",
                      "INSTRUMENT_FINDINGS_MISMATCH",
                      "QUARANTINE_SET_MISMATCH",
                      "INGRESS_COUNTS_MISMATCH",
                      "CLOCK_EVIDENCE_MISMATCH",
                      "CONTRADICTION_SET_MISMATCH",
                      "OUTPUT_SHAPE_MISMATCH",
                      "OTHER_VALUE_MISMATCH"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}