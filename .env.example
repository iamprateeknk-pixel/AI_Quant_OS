# Required only for paper control commands. Keep the real value in your environment.
AI_QUANT_OPERATOR_TOKEN=
# Optional SQLite file for paper orders, fills, audit, safety, calibration, snapshots and agent runs.
# Quotes and recent world-state bars remain in memory.
AI_QUANT_PAPER_DB=
# Optional advisory provider. Disabled unless explicitly set to true.
AI_QUANT_JEV_ENABLED=false
# Server-only credential and pinned version; leave blank while disabled.
AI_QUANT_JEV_API_KEY=
AI_QUANT_JEV_MODEL=
# Optional OpenAI advisory reviewer; server-only key and dated GPT snapshot.
AI_QUANT_REVIEW_ENABLED=false
AI_QUANT_REVIEW_API_KEY=
AI_QUANT_REVIEW_MODEL=
