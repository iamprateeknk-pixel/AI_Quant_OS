# Required only for paper control commands. Keep the real value in your environment.
AI_QUANT_OPERATOR_TOKEN=
# Optional SQLite file for paper orders, fills, audit, safety, calibration, snapshots and agent runs.
# Quotes and recent world-state bars remain in memory.
AI_QUANT_PAPER_DB=
# Optional immutable 18-role routine tool-call policy. Requires persistent paper storage.
# Existing quota journals are restored even when this setting is removed.
# See docs/AGENT_CALL_BUDGET_HANDOFF.md; provider token/dollar accounting is separate.
AI_QUANT_AGENT_CALL_POLICY=
# Optional declared paper execution-drift window and threshold; no calibrated default.
# See docs/DRIFT_AGENT_HANDOFF.md. Missing policy leaves A14 unassessed.
AI_QUANT_DRIFT_POLICY=
# Optional advisory provider. Disabled unless explicitly set to true.
AI_QUANT_JEV_ENABLED=false
# Server-only credential and pinned version; leave blank while disabled.
AI_QUANT_JEV_API_KEY=
AI_QUANT_JEV_MODEL=
# Optional OpenAI advisory reviewer; server-only key and dated GPT snapshot.
AI_QUANT_REVIEW_ENABLED=false
AI_QUANT_REVIEW_API_KEY=
AI_QUANT_REVIEW_MODEL=

# Optional server-declared accounting owners for the legacy provider routes.
# Required with configured/retained call quotas; see PROVIDER_CALL_ADMISSION_HANDOFF.md.
# Values are cataloged agent@version with MODEL_REVIEW capability; no default owner.
AI_QUANT_CLASSIFICATION_OWNER=
AI_QUANT_REVIEW_OWNER=
