{
  "id": null,
  "uid": "paper-http-observations",
  "title": "Paper HTTP and Agent Observations",
  "description": "Volatile original SDK HTTP and agent execution measurements; failed/missing scrapes withhold current metric panels. Counts are operational attempts, not model quality or authority.",
  "tags": [
    "paper",
    "local-observations"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Paper HTTP and agent execution observations",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Local PAPER HTTP and agent execution measurements. Agent counts are terminal attempts, not model quality, accuracy, strategy performance or promotion evidence. Duration p95 is a bucket estimate, not an SLA. Check scrape status and observation age first. Missing data remains missing; no zeros are substituted."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Latest scrape: 1 accepted / 0 failed",
      "datasource": {
        "type": "prometheus",
        "uid": "paper-http-source"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"paper_http\"}",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "paper-http-source"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No scrape observation"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Scrape observation age",
      "datasource": {
        "type": "prometheus",
        "uid": "paper-http-source"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - timestamp(up{job=\"paper_http\"})",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "paper-http-source"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No scrape observation"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Requests per second",
      "datasource": {
        "type": "prometheus",
        "uid": "paper-http-source"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ai_quant_paper_http_duration_seconds_count{job=\"paper_http\"}[5m])) and on() (min(up{job=\"paper_http\"}) == 1)",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "paper-http-source"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No current measured samples",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP 5xx responses per second",
      "datasource": {
        "type": "prometheus",
        "uid": "paper-http-source"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ai_quant_paper_http_duration_seconds_count{job=\"paper_http\",status_class=\"5xx\"}[5m])) and on() (min(up{job=\"paper_http\"}) == 1)",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "paper-http-source"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No current measured samples",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "ASGI failures per second",
      "datasource": {
        "type": "prometheus",
        "uid": "paper-http-source"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ai_quant_paper_http_failures_total{job=\"paper_http\"}[5m])) and on() (min(up{job=\"paper_http\"}) == 1)",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "paper-http-source"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No current measured samples",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Observed request duration p95",
      "datasource": {
        "type": "prometheus",
        "uid": "paper-http-source"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ai_quant_paper_http_duration_seconds_bucket{job=\"paper_http\"}[5m]))) and on() (sum(rate(ai_quant_paper_http_duration_seconds_count{job=\"paper_http\"}[5m])) > 0) and on() (min(up{job=\"paper_http\"}) == 1)",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "paper-http-source"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No current measured samples",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "paper-http-source"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No current measured samples",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "id": 8,
      "title": "Agent graph attempts per second",
      "description": "Volatile terminal graph attempts by fixed agent and status. This is operational activity, not model quality or successful strategy performance.",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (agent_id,status) (rate(ai_quant_paper_agent_executions_total{job=\"paper_http\"}[5m])) and on() (min(up{job=\"paper_http\"}) == 1)",
          "legendFormat": "{{agent_id}} \u00b7 {{status}}",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "paper-http-source"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "paper-http-source"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No attributable execution sample",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "id": 9,
      "title": "Agent execution duration p95 (bucket estimate)",
      "description": "Attributable terminal execution durations only. UNCERTAIN recovery attempts have no duration sample; this estimate is not an SLA or model-quality measure.",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,agent_id,status) (rate(ai_quant_paper_agent_execution_duration_seconds_bucket{job=\"paper_http\"}[5m]))) and on(agent_id,status) (sum by (agent_id,status) (rate(ai_quant_paper_agent_execution_duration_seconds_count{job=\"paper_http\"}[5m])) > 0) and on() (min(up{job=\"paper_http\"}) == 1)",
          "legendFormat": "{{agent_id}} \u00b7 {{status}}",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "paper-http-source"
          }
        }
      ]
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}
