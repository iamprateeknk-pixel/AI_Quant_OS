{
  "id": null,
  "uid": "paper-http-observations",
  "title": "Paper HTTP Observations",
  "description": "Volatile original SDK HTTP measurements; failed/missing scrapes withhold current metric panels. No trading/delivery authority.",
  "tags": [
    "paper",
    "local-observations"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Paper HTTP observations",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Local paper HTTP metrics only. Check scrape status and observation age first. Historical samples are not current source health, trading state, complete traces or delivery proof. Missing data remains missing; no zeros are substituted. Route detail beyond capacity is grouped under OTHER_ROUTE."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Latest scrape: 1 accepted / 0 failed",
      "datasource": {
        "type": "prometheus",
        "uid": "paper-http-source"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"paper_http\"}",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "paper-http-source"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No scrape observation"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Scrape observation age",
      "datasource": {
        "type": "prometheus",
        "uid": "paper-http-source"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - timestamp(up{job=\"paper_http\"})",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "paper-http-source"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No scrape observation"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Requests per second",
      "datasource": {
        "type": "prometheus",
        "uid": "paper-http-source"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ai_quant_paper_http_duration_seconds_count{job=\"paper_http\"}[5m])) and on() (min(up{job=\"paper_http\"}) == 1)",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "paper-http-source"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No current measured samples",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP 5xx responses per second",
      "datasource": {
        "type": "prometheus",
        "uid": "paper-http-source"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ai_quant_paper_http_duration_seconds_count{job=\"paper_http\",status_class=\"5xx\"}[5m])) and on() (min(up{job=\"paper_http\"}) == 1)",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "paper-http-source"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No current measured samples",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "ASGI failures per second",
      "datasource": {
        "type": "prometheus",
        "uid": "paper-http-source"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ai_quant_paper_http_failures_total{job=\"paper_http\"}[5m])) and on() (min(up{job=\"paper_http\"}) == 1)",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "paper-http-source"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No current measured samples",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Observed request duration p95",
      "datasource": {
        "type": "prometheus",
        "uid": "paper-http-source"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ai_quant_paper_http_duration_seconds_bucket{job=\"paper_http\"}[5m]))) and on() (min(up{job=\"paper_http\"}) == 1)",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "paper-http-source"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No current measured samples",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}
