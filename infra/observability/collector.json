{
  "receivers": {
    "otlp": {
      "protocols": {
        "http": {
          "endpoint": "127.0.0.1:4318",
          "max_request_body_size": 262144
        }
      }
    }
  },
  "processors": {
    "memory_limiter": {
      "check_interval": "1s",
      "limit_mib": 128,
      "spike_limit_mib": 32
    }
  },
  "exporters": {
    "file/paper": {
      "path": "${env:AI_QUANT_COLLECTOR_TRACE_FILE}",
      "format": "json",
      "rotation": {
        "max_megabytes": 32,
        "max_days": 7,
        "max_backups": 3,
        "localtime": false
      }
    }
  },
  "service": {
    "telemetry": {
      "metrics": {"level": "none"},
      "logs": {"level": "warn"}
    },
    "pipelines": {
      "traces": {
        "receivers": ["otlp"],
        "processors": ["memory_limiter"],
        "exporters": ["file/paper"]
      }
    }
  }
}
